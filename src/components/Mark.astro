---
/**
 * The SkyKPI mark: a reticle. Circle, continuous crosshair, two gradient
 * quadrant wedges. Placeholder recreation in SVG; the master SVG will be
 * swapped in later (TODO).
 *
 * `animate` turns on the one signature motion moment: the crosshair
 * registering into alignment on load. Use it once per page (header).
 */
interface Props {
  size?: number;
  animate?: boolean;
  class?: string;
}
const { size = 34, animate = false, class: className = '' } = Astro.props;
const uid = `mk${Math.floor(Math.random() * 1e6)}`;
---

<svg
  class:list={['mark', className, { 'mark--animate': animate }]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={uid} x1="12" y1="12" x2="52" y2="52" gradientUnits="userSpaceOnUse">
      <stop stop-color="#1AB0C4"></stop>
      <stop offset="1" stop-color="#1296B0"></stop>
    </linearGradient>
  </defs>
  <g class="mark__wedges" fill={`url(#${uid})`}>
    <path d="M32 32 L32 14 A18 18 0 0 1 50 32 Z"></path>
    <path d="M32 32 L32 50 A18 18 0 0 1 14 32 Z"></path>
  </g>
  <circle class="mark__circle" cx="32" cy="32" r="20" stroke="currentColor" stroke-width="4"></circle>
  <line class="mark__line mark__line--v" x1="32" y1="5" x2="32" y2="59" stroke="currentColor" stroke-width="4" stroke-linecap="round"></line>
  <line class="mark__line mark__line--h" x1="5" y1="32" x2="59" y2="32" stroke="currentColor" stroke-width="4" stroke-linecap="round"></line>
</svg>

<style>
  .mark {
    color: var(--text-on-ink);
    flex: none;
  }

  :global(.on-paper) .mark {
    color: var(--text-on-paper);
  }

  /* Registration moment: lines slide into alignment, wedges settle in. */
  .mark--animate .mark__line--v {
    animation: mark-reg-v 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .mark--animate .mark__line--h {
    animation: mark-reg-h 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .mark--animate .mark__wedges {
    transform-origin: 50% 50%;
    animation: mark-reg-w 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes mark-reg-v {
    from { transform: translateX(-7px); opacity: 0.2; }
    to { transform: none; opacity: 1; }
  }

  @keyframes mark-reg-h {
    from { transform: translateY(7px); opacity: 0.2; }
    to { transform: none; opacity: 1; }
  }

  @keyframes mark-reg-w {
    from { transform: rotate(-14deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
</style>
