---
/**
 * FAQ section. Pass the same `items` array to the page's FAQPage JSON-LD
 * (see faqSchema in src/lib/schema.ts) so the visible text and the structured
 * data never drift apart.
 */
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Common questions' } = Astro.props;
---

<section class="section faq">
  <div class="container">
    <p class="tag reveal">Questions and answers</p>
    <h2 class="reveal">{heading}</h2>
    <dl class="faq__list">
      {
        items.map((item) => (
          <div class="faq__item reveal">
            <dt>
              <h3>{item.q}</h3>
            </dt>
            <dd>
              <p>{item.a}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .faq__list {
    margin: 2.25rem 0 0;
    max-width: 46rem;
  }

  .faq__item {
    padding: 1.4rem 0;
    border-top: 1px solid var(--hairline);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .faq__item h3 {
    margin: 0;
  }

  .faq__item dd {
    margin: 0.75rem 0 0;
  }

  .faq__item p {
    margin: 0;
    color: var(--graphite);
  }
</style>
