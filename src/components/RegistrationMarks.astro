---
/**
 * Small teal crosshair registration marks for the corners of a key section.
 * Parent must be position: relative.
 */
const corners = ['tl', 'tr', 'bl', 'br'];
---

{
  corners.map((c) => (
    <svg class={`regmark regmark--${c}`} viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <line x1="9" y1="0" x2="9" y2="18" stroke="currentColor" stroke-width="1" />
      <line x1="0" y1="9" x2="18" y2="9" stroke="currentColor" stroke-width="1" />
      <circle cx="9" cy="9" r="4.5" stroke="currentColor" stroke-width="1" />
    </svg>
  ))
}
