---
/**
 * Related pages: the cross-links at the end of a page.
 * Descriptive anchor text on purpose, so readers and crawlers both know
 * what the linked page covers before they open it.
 */
interface RefLink {
  href: string;
  label: string;
}

interface Props {
  links: RefLink[];
  heading?: string;
}

const { links, heading = 'Related' } = Astro.props;
---

<section class="section related">
  <div class="container">
    <p class="tag reveal">{heading}</p>
    <ul class="related__list">
      {
        links.map((l) => (
          <li class="reveal">
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .related {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 44rem;
  }

  .related__list li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }

  .related__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .related__list a {
    color: var(--black);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .related__list a:hover {
    color: var(--graphite);
  }
</style>
