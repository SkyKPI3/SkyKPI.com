---
/**
 * A prose section of a guide: eyebrow, question-shaped H2, and body copy in
 * the default slot. `mist` and `marks` are accepted for compatibility with
 * existing guides and no longer change the rendering.
 */
interface Props {
  tag: string;
  heading: string;
  mist?: boolean;
  marks?: boolean;
}
const { tag, heading } = Astro.props;
---

<section class="section">
  <div class="container prose__inner">
    <p class="tag reveal">{tag}</p>
    <h2 class="reveal">{heading}</h2>
    <div class="reveal prose__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .prose__inner {
    max-width: 46rem;
  }

  .prose__body {
    margin-top: 2rem;
  }

  .prose__body :global(h3) {
    margin-top: 2rem;
  }

  .prose__body :global(strong) {
    font-weight: 500;
  }
</style>
