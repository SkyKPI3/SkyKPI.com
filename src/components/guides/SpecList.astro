---
/**
 * A labeled list of rows with copy, like a schedule of services.
 * rows: [{ id, name, copy }]
 * The row id is kept in the data for authors but is not rendered.
 * `mist` is accepted for compatibility and does nothing.
 */
interface Row {
  id: string;
  name: string;
  copy: string;
}

interface Props {
  tag: string;
  heading: string;
  intro?: string;
  rows: Row[];
  mist?: boolean;
}
const { tag, heading, intro, rows } = Astro.props;
---

<section class="section">
  <div class="container sl__inner">
    <p class="tag reveal">{tag}</p>
    <h2 class="reveal">{heading}</h2>
    {intro && <p class="reveal sl__intro">{intro}</p>}

    <dl class="sl__table">
      {
        rows.map((r) => (
          <div class="sl__row reveal">
            <dt>
              <h3>{r.name}</h3>
            </dt>
            <dd>{r.copy}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .sl__inner {
    max-width: 52rem;
  }

  .sl__intro {
    margin-top: 1.5rem;
  }

  .sl__table {
    margin: 2.25rem 0 0;
  }

  .sl__row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }

  .sl__row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .sl__row h3 {
    margin: 0;
  }

  .sl__row dd {
    margin: 0;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .sl__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
