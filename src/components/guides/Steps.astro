---
/**
 * Ordered steps or phases. steps: [{ id, title, copy }]
 * The id is kept in the data for authors but is not rendered; the list
 * carries its own order. `wide` renders three-up on desktop for timelines.
 * `mist` and `marks` are accepted for compatibility and do nothing.
 */
interface Step {
  id: string;
  title: string;
  copy: string;
}

interface Props {
  tag: string;
  heading: string;
  intro?: string;
  steps: Step[];
  wide?: boolean;
  mist?: boolean;
  marks?: boolean;
}
const { tag, heading, intro, steps, wide = false } = Astro.props;
---

<section class="section">
  <div class:list={['container', { 'st__inner--narrow': !wide }]}>
    <p class="tag reveal">{tag}</p>
    <h2 class="reveal">{heading}</h2>
    {intro && <p class="reveal st__intro">{intro}</p>}

    <ol class:list={['st__list', { 'st__list--wide': wide }]}>
      {
        steps.map((s) => (
          <li class="reveal">
            <h3>{s.title}</h3>
            <p class="dim">{s.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .st__inner--narrow {
    max-width: 46rem;
  }

  .st__intro {
    max-width: 42rem;
    margin-top: 1.5rem;
  }

  .st__list {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    counter-reset: step;
  }

  .st__list li {
    counter-increment: step;
    border-top: 1px solid var(--hairline);
    padding: 1.25rem 0 1.5rem;
  }

  .st__list li::before {
    content: counter(step);
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--graphite);
    margin-bottom: 0.75rem;
  }

  .st__list h3 {
    margin: 0 0 0.5rem;
  }

  .st__list p {
    margin: 0;
  }

  .st__list--wide {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (max-width: 820px) {
    .st__list--wide {
      grid-template-columns: 1fr;
    }
  }
</style>
