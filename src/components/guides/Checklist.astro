---
/**
 * A checklist with empty boxes, grouped or flat.
 * groups: [{ id, cat, items: [string] }]
 * The group id is kept in the data for authors but is not rendered.
 * `mist` is accepted for compatibility and does nothing.
 */
interface Group {
  id: string;
  cat: string;
  items: string[];
}

interface Props {
  tag: string;
  heading: string;
  intro?: string;
  groups: Group[];
  mist?: boolean;
}
const { tag, heading, intro, groups } = Astro.props;
---

<section class="section">
  <div class="container cl__inner">
    <p class="tag reveal">{tag}</p>
    <h2 class="reveal">{heading}</h2>
    {intro && <p class="reveal cl__intro">{intro}</p>}

    {
      groups.map((group) => (
        <div class="cl__group reveal">
          {group.cat && <h3>{group.cat}</h3>}
          <ul class="cl__items">
            {group.items.map((item) => (
              <li>
                <span class="cl__box" aria-hidden="true" />
                <p>{item}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cl__inner {
    max-width: 46rem;
  }

  .cl__intro {
    margin-top: 1.5rem;
  }

  .cl__group {
    margin-top: 2.5rem;
  }

  .cl__group h3 {
    margin-bottom: 0.75rem;
  }

  .cl__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cl__items li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.9rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--hairline);
  }

  .cl__items li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .cl__box {
    width: 1rem;
    height: 1rem;
    margin-top: 0.35rem;
    border: 1px solid var(--black);
    background: var(--white);
  }

  .cl__items p {
    margin: 0;
  }
</style>
