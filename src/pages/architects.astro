---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import heroShot from '../assets/photos/precast/IMG_2998.jpeg';
import detailShot from '../assets/photos/precast/IMG_1379.jpeg';

const faqs = [
  {
    q: 'What does a website for an architecture firm cost?',
    a: 'A Starter site of up to three pages is $1,500, one time, and a Standard site of up to eight pages is $3,000. Both come with a portfolio layout. Care plans are $50 or $100 a month.',
  },
  {
    q: 'Why would an architecture firm hire a precast-focused marketing firm?',
    a: 'The manufacturers we work for market to architects, so we spend every day on how architects look for products, firms and people. That is the same knowledge a firm needs to show its own work well.',
  },
  {
    q: 'Can you do more than the website?',
    a: 'Yes. Project photography and LinkedIn are quoted separately, and larger firms that want a full monthly program can start a marketing retainer.',
  },
];

const jsonLd: object[] = [];
---

<Sheet
  title="Websites for Architecture Firms | Lombard Belz"
  description="Fixed-price portfolio websites for architecture firms: $1,500 for up to three pages or $3,000 for up to eight, with care plans from $50 a month."
  path="/architects/"
  sheetName="Architects"
  parent={{ href: "/manufacturers/", label: "Marketing" }}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A finished building with tan brick, cast stone banding, and dark metal louvers under a clear sky."
        widths={[480, 768, 1280, 1920]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <div class="container hero__content">
      <p class="tag hero__kicker">Websites for architects</p>
      <h1>Portfolio websites for architecture firms, at a fixed price.</h1>
      <p class="lede hero__sub">
        You get a fast portfolio website that shows your built work the way a selection committee reads it, for one fixed price starting at $1,500, and we keep it running from $50 a month.
      </p>
    </div>
  </section>

  <section class="section on-navy angle">
    <div class="container angle__grid">
      <div>
        <span class="rule reveal"></span>
        <p class="tag reveal">How firms get work</p>
        <h2 class="reveal">The website is where a referral checks your work.</h2>
      </div>
      <div class="reveal">
        <p class="stat"><strong>89%</strong> of AIA members surveyed agree that relationships matter more than marketing for winning new business.</p>
        <p>
          Your work comes from relationships, and before a new client calls, they look you up. The website is where they see the projects, so it should load fast, show the work well and make it easy to reach you.
        </p>
        <p class="source">Source: The American Institute of Architects, Technology, Culture and the Future of the Architectural Firm, 2021. Survey of 329 AIA members.</p>
      </div>
    </div>
  </section>

  <section class="section on-mist">
    <div class="container cols cols--2 packages">
      <div class="package reveal">
        <p class="tag">Starter</p>
        <p class="package__price">$1,500</p>
        <p class="dim">One time. Up to three pages, portfolio layout.</p>
        <p class="package__care">Care plan <strong>$50 a month</strong></p>
      </div>
      <div class="package reveal">
        <p class="tag">Standard</p>
        <p class="package__price">$3,000</p>
        <p class="dim">One time. Up to eight pages, portfolio layout.</p>
        <p class="package__care">Care plan <strong>$100 a month</strong>, with up to 30 minutes of edits</p>
      </div>
    </div>
  </section>

  <section class="section scope">
    <div class="container scope__grid">
      <div class="scope__list">
        <p class="tag reveal">Scope of work</p>
        <h2 class="reveal">What a firm website includes</h2>
        <ul>
          <li class="reveal">
            <h3>A portfolio-grade website</h3>
            <p class="dim">
              Project pages that read the way a committee reads: program,
              materials, outcome. Fast, quiet, and built around the work.
            </p>
          </li>
          <li class="reveal">
            <h3>Project photography, if you want it</h3>
            <p class="dim">
              Finished-work photography that holds up on a conference-room screen, quoted separately.
            </p>
          </li>
          <li class="reveal">
            <h3>Care that keeps it current</h3>
            <p class="dim">
              Hosting, security, backups and search indexing every month, and on the Standard plan, edits when a new project finishes.
            </p>
          </li>
        </ul>
      </div>
      <div class="scope__media photo-treat reveal">
        <Image
          src={detailShot}
          alt="Looking up the corner of a tower where a precast concrete fin meets a blue glass curtain wall."
          widths={[360, 480, 800, 1200]}
          width={1200}
          sizes="(min-width: 821px) 40vw, 100vw"
          loading="lazy"
          quality={72}
        />
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What firms ask us" />

  <Related
    links={[
      {
        href: '/guides/marketing-for-architects/',
        label: 'Guide: marketing for architects, with a 20-point self-audit',
      },
      {
        href: '/pricing/#websites',
        label: 'Website packages and care plans side by side',
      },
      {
        href: '/contractors/',
        label: 'Marketing and websites for general contractors',
      },
      {
        href: '/subcontractors/',
        label: 'Marketing and websites for trade and specialty subcontractors',
      },
    ]}
  />

  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Talk to us about your firm.</h2>
      <p class="dim reveal">We answer within one business day.</p>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .stat {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 300;
    color: var(--white);
  }

  .stat strong {
    display: block;
    font-size: clamp(2.75rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }

  .angle p {
    color: var(--white);
  }

  .angle .source {
    color: var(--graphite-on-black);
  }

  .packages {
    margin-top: 0;
  }

  .package {
    background: var(--white);
    padding: 2rem !important;
    border-top: 4px solid var(--navy) !important;
  }

  .package__price {
    margin: 0;
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    line-height: 1;
    color: var(--navy);
  }

  .package__care {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .package__care strong {
    font-weight: 500;
    color: var(--navy);
  }

  .hero {
    position: relative;
    min-height: 72svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: 3rem 0 clamp(3rem, 7vw, 5rem);
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__sub {
    max-width: 34rem;
  }

  .angle__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .scope__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .scope__list ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .scope__list li {
    border-top: 1px solid var(--hairline);
    padding: 1.25rem 0;
  }

  .scope__list h3 {
    margin: 0.5rem 0;
  }

  .scope__list p {
    margin: 0;
  }

  .scope__media {
    aspect-ratio: 3 / 4;
    position: sticky;
    top: 2rem;
  }

  .scope__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .angle__grid,
    .scope__grid {
      grid-template-columns: 1fr;
    }

    .scope__media {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
