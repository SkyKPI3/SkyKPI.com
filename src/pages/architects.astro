---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import RegistrationMarks from '../components/RegistrationMarks.astro';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../lib/schema';
import heroShot from '../assets/photos/precast/DJI_0284.JPG';
import detailShot from '../assets/photos/precast/IMG_1379.jpeg';

const faqs = [
  {
    q: 'Why would an architecture firm hire a precast-focused marketing firm?',
    a: 'Our core expertise is the precast concrete industry, which means we study architects for a living. The producers we serve market to you, so we know how firms are evaluated, what specifiers check, and how built work gets seen. That fluency is exactly what we bring to marketing the firm itself.',
  },
  {
    q: 'What does marketing for an architecture firm include?',
    a: 'A portfolio-grade website, project photography, and a steady presence on the channels where clients and collaborators look. Email when it earns its place. Everything is built so the next selection committee sees the work at its best.',
  },
  {
    q: 'What does it cost?',
    a: 'One monthly retainer scoped to what the firm needs, with no hourly billing. We set the number in a conversation about scope, not on a rate card.',
  },
];

const jsonLd = [faqSchema(faqs)];
---

<Sheet
  title="Marketing and Websites for Architects | SkyKPI"
  description="SkyKPI builds websites, marketing, and social media for architecture firms, with core expertise in the precast concrete industry."
  path="/architects/"
  sheet="A-210"
  sheetName="Architects"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A finished thin-brick precast facade with cast stone banding, receding in strong perspective under a blue sky."
        widths={[768, 1280, 1920]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <RegistrationMarks />
    <div class="container hero__content">
      <p class="tag hero__kicker">Sheet A-210 &middot; Marketing / Architects</p>
      <h1>Your built work should win the next commission.</h1>
      <hr class="dimline" aria-hidden="true" />
      <p class="lede hero__sub">
        SkyKPI builds websites, marketing, and social media for architects,
        with core expertise in the precast concrete industry.
      </p>
    </div>
  </section>

  <section class="section sheet-dark angle">
    <div class="container angle__grid">
      <div>
        <p class="tag reveal">Why us</p>
        <h2 class="reveal">We already study how architects choose.</h2>
        <hr class="dimline reveal" aria-hidden="true" />
      </div>
      <div class="reveal">
        <p>
          Architects are the audience our precast clients market to. We spend
          every day studying how firms evaluate products, portfolios, and the
          people they hire, because that is who we help producers reach.
        </p>
        <p>
          That specifier-side fluency now works for the architects themselves.
          We know what a selection committee reads, what a developer checks,
          and what makes built work carry a firm's reputation.
        </p>
      </div>
    </div>
  </section>

  <section class="section sheet-dark sheet-dark--deep scope">
    <RegistrationMarks />
    <div class="container scope__grid">
      <div class="scope__list">
        <p class="tag reveal">Scope of work</p>
        <h2 class="reveal">What we build for firms</h2>
        <hr class="dimline reveal" aria-hidden="true" />
        <ul>
          <li class="reveal">
            <span class="tag tag--dim">W-1</span>
            <h3>A portfolio-grade website</h3>
            <p class="dim">
              Project pages that read the way a committee reads: program,
              materials, outcome. Fast, quiet, and built around the work.
            </p>
          </li>
          <li class="reveal">
            <span class="tag tag--dim">W-2</span>
            <h3>Project photography</h3>
            <p class="dim">
              Finished-work photography that holds up on a conference-room
              screen, not phone shots from a site visit.
            </p>
          </li>
          <li class="reveal">
            <span class="tag tag--dim">W-3</span>
            <h3>A presence between award cycles</h3>
            <p class="dim">
              A steady LinkedIn presence that keeps the firm visible to
              clients, collaborators, and future hires all year.
            </p>
          </li>
        </ul>
      </div>
      <div class="scope__media photo-treat reveal">
        <Image
          src={detailShot}
          alt="Looking up the corner of a tower where a precast concrete fin meets a blue glass curtain wall."
          widths={[480, 800, 1200]}
          width={1200}
          sizes="(min-width: 821px) 40vw, 100vw"
          loading="lazy"
          quality={72}
        />
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What firms ask us" />

  <section class="section sheet-dark cta">
    <div class="container cta__inner">
      <p class="tag reveal">Sheet A-500</p>
      <h2 class="reveal">Show us the work you want seen.</h2>
      <hr class="dimline dimline--center reveal" aria-hidden="true" />
      <div class="reveal">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .hero {
    position: relative;
    min-height: 72svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: calc(var(--header-h) + 3rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__sub {
    max-width: 34rem;
  }

  .angle__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .scope__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .scope__list ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .scope__list li {
    border-top: 1px solid var(--hairline-on-ink);
    padding: 1.25rem 0;
  }

  .scope__list h3 {
    margin: 0.5rem 0;
  }

  .scope__list p {
    margin: 0;
  }

  .scope__media {
    aspect-ratio: 3 / 4;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .scope__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .angle__grid,
    .scope__grid {
      grid-template-columns: 1fr;
    }

    .scope__media {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
