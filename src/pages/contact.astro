---
import Sheet from '../layouts/Sheet.astro';
import RegistrationMarks from '../components/RegistrationMarks.astro';

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact SkyKPI',
  url: 'https://skykpi.com/contact/',
  about: {
    '@type': 'Organization',
    name: 'SkyKPI LLC',
    email: 'hello@skykpi.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Frankfort',
      addressRegion: 'IL',
      addressCountry: 'US',
    },
  },
};
---

<Sheet
  title="Contact SkyKPI | Start the Conversation"
  description="Contact SkyKPI about marketing or association management for the precast and AEC industries. We reply within one business day."
  path="/contact/"
  sheet="A-500"
  sheetName="Contact"
  jsonLd={[contactPage]}
>
  <section class="section sheet-dark contact">
    <RegistrationMarks />
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="tag">Sheet A-500 &middot; Contact</p>
        <h1>Start the conversation.</h1>
        <hr class="dimline" aria-hidden="true" />
        <p class="lede">
          Tell us what you need to sell, or what your board needs handled. We
          reply within one business day.
        </p>
        <dl class="contact__meta">
          <div>
            <dt class="tag tag--dim">Email</dt>
            <dd><a href="mailto:hello@skykpi.com">hello@skykpi.com</a></dd>
          </div>
          <div>
            <dt class="tag tag--dim">Office</dt>
            <dd>Frankfort, Illinois</dd>
          </div>
        </dl>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        action="/contact/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp" aria-hidden="true">
          <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label class="tag tag--dim" for="f-name">Name</label>
          <input id="f-name" name="name" type="text" required autocomplete="name" />
        </div>

        <div class="field">
          <label class="tag tag--dim" for="f-company">Company or association</label>
          <input id="f-company" name="company" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label class="tag tag--dim" for="f-email">Email</label>
          <input id="f-email" name="email" type="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label class="tag tag--dim" for="f-message">What do you need</label>
          <textarea id="f-message" name="message" rows="6" required></textarea>
        </div>

        <button class="btn" type="submit">Send it</button>
      </form>
    </div>
  </section>
</Sheet>

<style>
  .contact {
    padding-top: calc(var(--header-h) + var(--space-section));
    min-height: 80svh;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  .contact__meta {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1.25rem;
  }

  .contact__meta div {
    display: grid;
    gap: 0.3rem;
  }

  .contact__meta dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .contact__meta a {
    color: var(--teal);
    text-decoration: none;
  }

  .contact__meta a:hover {
    text-decoration: underline;
  }

  .contact__form {
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--hairline-on-ink);
    background: var(--ink-2);
  }

  .hp {
    position: absolute;
    left: -9999px;
    margin: 0;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-on-ink);
    background: var(--ink);
    border: 1px solid var(--hairline-on-ink);
    border-radius: 0;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--teal);
    outline-offset: 0;
    border-color: transparent;
  }

  .contact__form .btn {
    justify-self: start;
  }
</style>
