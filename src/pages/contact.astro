---
import Sheet from '../layouts/Sheet.astro';

// Three routed addresses. No form: rule 8 of the voice standard.
const routes = [
  { label: 'New business', email: 'hello@lombardbelz.com', contactType: 'sales' },
  { label: 'Association boards', email: 'boards@lombardbelz.com', contactType: 'customer service' },
  { label: 'Press and speaking', email: 'press@lombardbelz.com', contactType: 'public relations' },
];

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Lombard Belz',
  url: 'https://lombardbelz.com/contact/',
  about: {
    '@type': 'Organization',
    '@id': 'https://lombardbelz.com/#organization',
    name: 'Lombard Belz',
    legalName: 'SkyKPI LLC',
    email: 'hello@lombardbelz.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Frankfort',
      addressRegion: 'IL',
      addressCountry: 'US',
    },
    contactPoint: routes.map((r) => ({
      '@type': 'ContactPoint',
      contactType: r.contactType,
      name: r.label,
      email: r.email,
      areaServed: 'US',
      availableLanguage: 'en',
    })),
  },
};
---

<Sheet
  title="Contact Lombard Belz | Frankfort, Illinois"
  description="Email Lombard Belz about marketing or association management for precast and AEC. We answer within two working days."
  path="/contact/"
  sheetName="Contact"
  jsonLd={[contactPage]}
>
  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="tag">Contact</p>
        <h1>Contact Lombard Belz.</h1>
        <p class="lede">Email the address below that fits your question. We answer within two working days.</p>
        <dl class="contact__meta">
          <div>
            <dt class="tag">Base</dt>
            <dd>Frankfort, Illinois</dd>
          </div>
          <div>
            <dt class="tag">Service area</dt>
            <dd>United States</dd>
          </div>
        </dl>
      </div>

      <ul class="routes">
        {
          routes.map((r) => (
            <li class="route">
              <p class="tag route__label">{r.label}</p>
              <a class="route__email" href={`mailto:${r.email}`}>{r.email}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Sheet>

<style>
  .contact {
    padding-top: var(--space-section);
    min-height: 70svh;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  .contact__meta {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1.25rem;
  }

  .contact__meta div {
    display: grid;
    gap: 0.3rem;
  }

  .contact__meta dd {
    margin: 0;
  }

  .contact__meta .tag {
    margin-bottom: 0;
  }

  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .route {
    padding: 1.5rem 0;
    border-top: 1px solid var(--hairline);
  }

  .route:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .route__label {
    margin-bottom: 0.5rem;
  }

  .route__email {
    display: inline-block;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--black);
    text-decoration: none;
    border-bottom: 1px solid var(--black);
    padding-bottom: 0.1rem;
    user-select: all;
    overflow-wrap: anywhere;
  }

  .route__email:hover {
    color: var(--graphite);
    border-bottom-color: var(--graphite);
  }
</style>
