---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Sheet from '../../layouts/Sheet.astro';

export async function getStaticPaths() {
  const entries = await getCollection('fieldnotes');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// The caption's first sentence carries the meta description.
const plain = entry.body?.replace(/\s+/g, ' ').trim() ?? '';
const firstSentence = (plain.match(/^.*?[.?!](?=\s|$)/)?.[0] ?? plain).slice(0, 160);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString().slice(0, 10),
  url: `https://skykpi.com/field-notes/${entry.id}/`,
  description: firstSentence,
  author: { '@type': 'Organization', name: 'SkyKPI' },
  publisher: {
    '@type': 'Organization',
    name: 'SkyKPI',
    logo: {
      '@type': 'ImageObject',
      url: 'https://skykpi.com/icon-512.png',
    },
  },
};
---

<Sheet
  title={`${entry.data.title} | Field Notes | SkyKPI`}
  description={firstSentence}
  path={`/field-notes/${entry.id}/`}
  sheetName="Field Notes"
  jsonLd={[article]}
>
  <article class="section note">
    <div class="container note__inner">
      <p class="tag">
        <a class="note__back" href="/field-notes/">Field Notes</a>
      </p>
      <h1>{entry.data.title}</h1>

      <figure class="note__figure">
        <div class="photo-treat photo-treat--light">
          <Image
            src={entry.data.image}
            alt={entry.data.imageAlt}
            widths={[600, 900, 1400]}
            width={1400}
            sizes="(min-width: 900px) 48rem, 100vw"
            loading="eager"
            fetchpriority="high"
            quality={78}
          />
        </div>
      </figure>

      <div class="note__caption">
        <Content />
      </div>

      <p class="meta note__date">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {dateFmt.format(entry.data.date)}
        </time>
      </p>

      <p class="note__more">
        <a class="btn btn--ghost" href="/field-notes/">All field notes</a>
      </p>
    </div>
  </article>
</Sheet>

<style>
  .note {
    padding-top: var(--space-section);
  }

  .note__inner {
    max-width: 48rem;
  }

  .note__back {
    color: inherit;
  }

  .note h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .note__back {
    text-decoration: none;
  }

  .note__figure {
    margin: 2rem 0 2.25rem;
  }

  /* Field note photography stays closer to how it was shot: the site's
     dark wash would fight the graphics baked into these posts. */
  .note__figure :global(.photo-treat--light)::before {
    background: none;
  }

  .note__figure :global(img) {
    width: 100%;
    height: auto;
  }

  .note__caption :global(p) {
    font-size: 1.05rem;
    max-width: 40rem;
  }

  .note__caption :global(p:last-child) {
    margin-bottom: 0;
  }

  .note__date {
    margin-top: 2rem;
  }

  .note__more {
    margin-top: 2.5rem;
  }
</style>
