---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import { faqSchema, serviceSchema } from '../lib/schema';
import bandShot from '../assets/photos/assoc/IMG_4068.jpeg';
import galaShot from '../assets/photos/assoc/IMG_1976.jpeg';

const faqs = [
  {
    q: 'What does an association management company handle?',
    a: 'Everything an executive director and staff would: events, membership, sponsor programs, communications, finances alongside your treasurer, and board support. The association keeps its own name and board. We supply the team and the systems behind it.',
  },
  {
    q: 'What does association management cost?',
    a: 'One fee scoped to the association’s size and calendar, set in a conversation with the board. There is no hourly billing. For many associations the fee compares to a single director’s salary and benefits, and it buys a whole team.',
  },
  {
        q: 'Do we have to use an off-the-shelf membership system?',
    a: 'No. We build the website, membership system, event registration, and continuing education tracking in house, so they fit how your association works. SkyKPI builds and maintains the software, and the association owns its domain, its member data, and its records.',
  },
  {
    q: 'How is this different from hiring an executive director?',
    a: 'With a management team, operations and records depend less on any one person. Full-team management gives the association an events person, a communications person, and a membership person, with continuity that survives turnover.',
  },
  {
    q: 'Do you work with associations outside construction?',
    a: 'Our focus is trade and professional associations in precast concrete, architecture, and construction. Your board should never have to explain the industry to its own staff.',
  },
];

const jsonLd = [
  serviceSchema({
    name: 'Association Management',
    description:
      'Full-team association management for AEC trade and professional associations: events, membership, sponsors, communications, and board support for one fee.',
    url: 'https://skykpi.com/associations/',
    serviceType: 'Association management',
  }),
];

const services = [
    {
    id: 'M-0',
    name: 'Custom platforms',
    copy: 'The website, member sign-up and renewals, event registration, and continuing education tracking, built in house for your association.',
  },
  {
    id: 'M-1',
    name: 'Events',
    copy: 'Annual meetings, conferences, plant tours, and golf outings, with the planning, registration, vendors, and on-site work behind them.',
  },
  {
    id: 'M-2',
    name: 'Membership',
    copy: 'Recruitment, renewals, onboarding, and a clean roster your board can trust at budget time.',
  },
  {
    id: 'M-3',
    name: 'Sponsors',
    copy: 'Sponsorship packages that track attendance and follow-up, so companies can decide on renewal with numbers.',
  },
  {
    id: 'M-4',
    name: 'Communications',
    copy: 'The newsletter, the website, and member updates that get opened and read.',
  },
  {
    id: 'M-5',
    name: 'Board support',
    copy: 'Agendas, minutes, budgets, and written procedures the whole team works from.',
  },
];
---

<Sheet
  title="AEC Association Management Company | SkyKPI"
  description="Association management for AEC trade associations, with the website, membership, and event systems built in house around how your association works."
  path="/associations/"
  sheetName="Associations"
  jsonLd={jsonLd}
>
  <!-- PAPER HERO -->
  <section class="section open">
    <div class="container">
      <p class="tag open__kicker">Association Management</p>
      <h1>Association management for architecture and construction associations.</h1>
      <p class="lede open__sub">
        Your board gets a team to run events, membership, sponsor programs, communications, and board meetings for one management fee. Your website, membership system, and event registration are built in house around how your association already works. SkyKPI is an association management company for trade associations in precast concrete and in architecture, engineering, and construction.
      </p>
    </div>
  </section>

  <!-- SPEC SHEET -->
  <section class="section spec">
    <div class="container">
      <p class="tag reveal">Schedule of services</p>
      <h2 class="reveal">What full-team management covers</h2>
      <dl class="spec__table">
        {
          services.map((s) => (
            <div class="spec__row reveal">
              <dt>
                <h3>{s.name}</h3>
              </dt>
              <dd>{s.copy}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

    <!-- CUSTOM PLATFORMS -->
  <section class="section boards">
    <div class="container boards__grid">
      <div>
        <p class="tag reveal">Built in house</p>
        <h2 class="reveal">Custom platforms for members and events</h2>
      </div>
      <div class="reveal">
        <p>
          Your members can join, renew, register, and track continuing education in a system built for your association. We write the software ourselves, so it follows your dues structure, your event formats, and your continuing education rules. Staff and members do not have to work around what a packaged system cannot do.
        </p>
        <p>
          What we can build for your association: the public website, event registration your members can finish without creating an account, self-serve sign-up and renewal for firms and partners, a continuing education tracker, and a searchable awards archive. Changes the board asks for are made by the same team that built the system.
        </p>
        <p>
          The platforms run on standard hosting and database services. SkyKPI builds and maintains the software, including access controls and data backups, as part of the management fee. The association owns its domain, its member data, and its records. If the association ever changes management, we export your member data and association records in standard formats and help with the move.
        </p>
      </div>
    </div>
  </section>


  <!-- PHOTO BAND -->
  <section class="band photo-treat">
    <Image
      src={bandShot}
      alt="Association members seated at long tables with laptops during an education session."
      widths={[480, 768, 1280, 1920]}
        width={1920}
      sizes="100vw"
      loading="lazy"
      quality={72}
    />
  </section>

  <!-- WHY BOARDS CHOOSE IT -->
  <section class="section boards">
    <div class="container boards__grid">
      <div>
        <p class="tag reveal">For the board</p>
        <h2 class="reveal">Why boards make the switch</h2>
      </div>
      <div class="reveal">
        <p>
          With a team, the work does not depend on one person, and a resignation does not take the association's history with it. We keep shared event records, sponsor histories, and membership data so another team member can take over.
        </p>
        <p>
          Associations run in peaks. A team scales up for
          the annual meeting and scales back in the quiet months, and the fee
          already accounts for both.
        </p>
        <p>
          We work in precast concrete, architecture, and construction every day, so your board never has to explain the industry to its own staff.
        </p>
      </div>
    </div>
  </section>

  <!-- GALA IMAGE + PULL -->
  <section class="section gala">
    <div class="container gala__grid">
      <div class="gala__media photo-treat reveal">
        <Image
          src={galaShot}
          alt="An association dinner in an ornate historic ballroom with a painted ceiling, seen from the back tables."
          widths={[360, 480, 800, 1200]}
          width={1200}
          sizes="(min-width: 821px) 40vw, 100vw"
          loading="lazy"
          quality={72}
        />
      </div>
      <div class="gala__copy">
        <p class="tag reveal">The standard</p>
        <h2 class="reveal">What the board should expect</h2>
        <p class="dim reveal">
          Members renew and sponsors come back when the events run well and the communication is steady. Every service on this page is aimed at those renewals.
        </p>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What boards ask us" />

  <Related
    links={[
      {
        href: '/marketing/',
        label: 'Marketing for precast producers, suppliers, and the architecture and construction firms around them',
      },
      {
        href: '/about/',
        label: 'How SkyKPI decides which clients to take',
      },
    ]}
  />

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Talk to us about your association.</h2>
      <p class="dim reveal cta__copy">
        We will walk your board through what full-team management looks like
        for your association, plainly and without a hard sell.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .work {
    padding-top: 0;
  }

  .work__grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .work__grid :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  .work__grid p {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }

  .open {
    padding-top: var(--space-section);
  }

  .open__kicker {
    margin-bottom: 1.4rem;
  }

  .open__sub {
    max-width: 40rem;
  }

  .spec {
    padding-top: 0;
  }

  .spec__table {
    margin: 2.25rem 0 0;
    max-width: 52rem;
  }

  .spec__row {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }

  .spec__row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .spec__row dt {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .spec__row h3 {
    margin: 0;
  }

  .spec__row dd {
    margin: 0;
    color: var(--graphite);
  }

  @media (max-width: 640px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  .band {
    height: clamp(15rem, 44vh, 24rem);
  }

  .band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boards__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .boards__grid {
      grid-template-columns: 1fr;
    }
  }

  .gala__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .gala__media {
    aspect-ratio: 3 / 4;
    max-height: 34rem;
  }

  .gala__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .gala__grid {
      grid-template-columns: 1fr;
    }

    .gala__media {
      aspect-ratio: 4 / 3;
      order: 2;
    }
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__copy {
    max-width: 32rem;
    margin-bottom: 2rem;
  }
</style>
