---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import RegistrationMarks from '../components/RegistrationMarks.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, serviceSchema } from '../lib/schema';
import bandShot from '../assets/photos/assoc/IMG_5288.jpeg';
import galaShot from '../assets/photos/assoc/IMG_1976.jpeg';

const faqs = [
  {
    q: 'What does an association management company handle?',
    a: 'Everything an executive director and staff would: events, membership, sponsor programs, communications, finances alongside your treasurer, and board support. The association keeps its name, its board, and its identity. We supply the team behind it.',
  },
  {
    q: 'What does association management cost?',
    a: 'One fee scoped to the association’s size and calendar, set in a conversation with the board. There is no hourly billing. For many associations the fee compares to a single director’s salary and benefits, and it buys a whole team.',
  },
  {
    q: 'How is this different from hiring an executive director?',
    a: 'A director is one person: one set of skills, one calendar, one resignation away from starting over. Full-team management gives the association an events person, a communications person, and a membership person, with continuity that survives turnover.',
  },
  {
    q: 'Do you work with associations outside construction?',
    a: 'Our focus is trade and professional associations in the precast concrete and AEC world. That focus is the point. Your board should never have to explain the industry to its own staff.',
  },
];

const jsonLd = [
  serviceSchema({
    name: 'Association Management',
    description:
      'Full-team association management for AEC trade and professional associations: events, membership, sponsors, communications, and board support for one fee.',
    url: 'https://skykpi.com/associations/',
    serviceType: 'Association management',
  }),
  faqSchema(faqs),
];

const services = [
  {
    id: 'M-1',
    name: 'Events',
    copy: 'Annual meetings, conferences, plant tours, golf outings, and the logistics nobody notices until they fail.',
  },
  {
    id: 'M-2',
    name: 'Membership',
    copy: 'Recruitment, renewals, onboarding, and a clean roster your board can trust at budget time.',
  },
  {
    id: 'M-3',
    name: 'Sponsors',
    copy: 'Sponsorship programs companies renew because they get value, not because they feel obligated.',
  },
  {
    id: 'M-4',
    name: 'Communications',
    copy: 'The newsletter, the website, and member updates that actually get opened and read.',
  },
  {
    id: 'M-5',
    name: 'Board support',
    copy: 'Agendas, minutes, budgets, and an executive function that does not live in one person’s head.',
  },
];
---

<Sheet
  title="Association Management for AEC Associations | SkyKPI"
  description="Full-team association management for AEC trade associations. Events, membership, sponsors, communications, and board support for one fee."
  path="/associations/"
  sheet="A-300"
  sheetName="Associations"
  jsonLd={jsonLd}
>
  <!-- PAPER HERO -->
  <section class="section on-paper hero">
    <RegistrationMarks />
    <div class="container">
      <p class="tag hero__kicker">Sheet A-300 &middot; Association Management</p>
      <h1>The single executive director model is breaking.</h1>
      <hr class="dimline" aria-hidden="true" />
      <p class="lede hero__sub">
        One person cannot run the events, the membership file, the sponsor
        program, the newsletter, and the board packet. When that person
        leaves, the association's memory leaves with them. SkyKPI gives AEC
        associations a full team for one fee.
      </p>
    </div>
  </section>

  <!-- SPEC SHEET -->
  <section class="section on-paper spec">
    <div class="container">
      <p class="tag reveal">Schedule of services</p>
      <h2 class="reveal">What full-team management covers</h2>
      <hr class="dimline reveal" aria-hidden="true" />
      <dl class="spec__table">
        {
          services.map((s) => (
            <div class="spec__row reveal">
              <dt>
                <span class="tag tag--dim">{s.id}</span>
                <h3>{s.name}</h3>
              </dt>
              <dd>{s.copy}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- PHOTO BAND -->
  <section class="band photo-treat">
    <Image
      src={bandShot}
      alt="A soaring convention center concourse with a curved white ribbed ceiling and a tall glass wall."
      widths={[768, 1280, 1920]}
        width={1920}
      sizes="100vw"
      loading="lazy"
      quality={72}
    />
  </section>

  <!-- WHY BOARDS CHOOSE IT -->
  <section class="section on-paper boards">
    <div class="container boards__grid">
      <div>
        <p class="tag reveal">For the board</p>
        <h2 class="reveal">Why boards make the switch</h2>
        <hr class="dimline reveal" aria-hidden="true" />
      </div>
      <div class="reveal">
        <p>
          Continuity, first. With a team there is no single point of failure,
          and nothing walks out the door with a resignation letter. The event
          calendar, the sponsor relationships, and the member history stay put.
        </p>
        <p>
          Capacity, second. Associations run in peaks. A team scales up for
          the annual meeting and scales back in the quiet months, and the fee
          already accounts for both.
        </p>
        <p>
          We work in the precast concrete and AEC world every day, so the
          board never has to explain the industry to its own staff.
        </p>
      </div>
    </div>
  </section>

  <!-- GALA IMAGE + PULL -->
  <section class="section sheet-dark gala">
    <RegistrationMarks />
    <div class="container gala__grid">
      <div class="gala__media photo-treat reveal">
        <Image
          src={galaShot}
          alt="An association dinner in an ornate historic ballroom with a painted ceiling, seen from the back tables."
          widths={[480, 800, 1200]}
          width={1200}
          sizes="(min-width: 821px) 40vw, 100vw"
          loading="lazy"
          quality={72}
        />
      </div>
      <div class="gala__copy">
        <p class="tag reveal">The standard</p>
        <h2 class="reveal">Members should leave the annual meeting proud of their association.</h2>
        <hr class="dimline reveal" aria-hidden="true" />
        <p class="dim reveal">
          That feeling is the product. It is what keeps members renewing,
          sponsors writing checks, and volunteers raising their hands. Every
          service on this sheet exists to produce it.
        </p>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What boards ask us" />

  <!-- CTA -->
  <section class="section sheet-dark cta">
    <div class="container cta__inner">
      <p class="tag reveal">Sheet A-500</p>
      <h2 class="reveal">Bring it to your board.</h2>
      <hr class="dimline dimline--center reveal" aria-hidden="true" />
      <p class="dim reveal cta__copy">
        We will walk your board through what full-team management looks like
        for your association, plainly and without a hard sell.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .hero {
    padding-top: calc(var(--header-h) + var(--space-section));
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__sub {
    max-width: 40rem;
  }

  .spec {
    padding-top: 0;
  }

  .spec__table {
    margin: 2.25rem 0 0;
    max-width: 52rem;
    border: 1px solid var(--hairline-on-paper);
  }

  .spec__row {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--hairline-on-paper);
  }

  .spec__row:first-child {
    border-top: 0;
  }

  .spec__row dt {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .spec__row h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .spec__row dd {
    margin: 0;
    color: var(--text-on-paper-dim);
  }

  @media (max-width: 640px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  .band {
    height: clamp(15rem, 44vh, 24rem);
  }

  .band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boards__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .boards__grid {
      grid-template-columns: 1fr;
    }
  }

  .gala__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .gala__media {
    aspect-ratio: 3 / 4;
    max-height: 34rem;
  }

  .gala__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .gala__grid {
      grid-template-columns: 1fr;
    }

    .gala__media {
      aspect-ratio: 4 / 3;
      order: 2;
    }
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__copy {
    max-width: 32rem;
    margin-bottom: 2rem;
  }
</style>
