---
import Sheet from '../../layouts/Sheet.astro';
import { publishedGuides } from '../../data/guides.mjs';

// Newest first; the registry gates anything future-dated until its Monday.
const guides = publishedGuides()
  .map((g) => ({
    href: `/guides/${g.slug}/`,
    title: g.title,
    line: g.line,
    date: g.published,
  }))
  .reverse();

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Lombard Belz Guides',
  url: 'https://lombardbelz.com/guides/',
  description:
    'Working guides on marketing and association management for the precast concrete and AEC industries, written from inside the industry.',
  isPartOf: { '@id': 'https://lombardbelz.com/#website' },
  publisher: { '@id': 'https://lombardbelz.com/#organization' },
};
---

<Sheet
  title="Guides | Marketing for Precast and AEC | Lombard Belz"
  description="Working guides on marketing and association management for precast and AEC: self-audits, checklists, and plain answers, written from inside the industry."
  path="/guides/"
  sheetName="Guides"
  jsonLd={[collectionPage]}
>
  <section class="section open">
    <div class="container">
      <p class="tag">Guides</p>
      <h1>Guides on precast and AEC marketing and association management.</h1>
      <p class="lede open__sub">
        The people who run marketing for this product mostly learned it on
        the job, and these guides fill the gaps. Each
        one is built to be used, with checklists you can score and steps you
        can take without hiring anyone.
      </p>

      <ul class="guides__list">
        {
          guides.map((g) => (
            <li class="reveal">
              <a class="guides__card" href={g.href}>
                <p class="meta guides__date">{g.date}</p>
                <h2>{g.title}</h2>
                <p class="dim">{g.line}</p>
                <span class="textlink">Read the guide</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Sheet>

<style>
  .open {
    padding-top: var(--space-section);
    min-height: 80svh;
  }

  .open__sub {
    max-width: 38rem;
  }

  .guides__list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    max-width: 46rem;
  }

  .guides__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
  }

  .guides__list li:last-child .guides__card {
    border-bottom: 1px solid var(--hairline);
  }

  .guides__date {
    margin: 0 0 0.5rem;
  }

  .guides__card h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin: 0 0 0.5rem;
  }

  .guides__card p {
    margin: 0 0 1rem;
  }

  .guides__card .textlink {
    margin-top: 0.5rem;
    align-self: flex-start;
  }
</style>
