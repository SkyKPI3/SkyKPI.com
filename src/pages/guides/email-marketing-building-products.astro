const faqs = [
  {
    q: "How often should a building products company email specifiers?",
    a: "Monthly is the standard and every other month is the floor. Anything less frequent and the list forgets who you are between issues, which defeats the purpose. Weekly is more than a building products audience wants and more than nearly any producer can fill with useful material. Pick the cadence you can hold through busy season, then hold it.",
  },
  {
    q: "What should be in the emails?",
    a: "Notes a specifier would keep or forward. Project photos with one lesson each, a detail worth borrowing, answers to the spec questions your reps hear on repeat. Keep the whole issue short enough to read between meetings. Company news belongs in a different channel, if anywhere.",
  },
  {
    q: "How do we build the list without buying one?",
    a: "Start with the contacts your reps already have: specifiers who have called with questions, estimators who have priced your product, general contractors who keep coming back. Then add a simple signup at the natural touchpoints, such as quote responses, sample requests, trade show conversations, and your resource pages. Ask permission when you add a name and make leaving easy. The list grows slower this way and performs far better, because everyone on it chose to be there.",
  },
  {
    q: "Does email actually influence specification?",
    a: "It keeps you in the consideration set the spec starts from, which is where the influence happens. Specification begins with the products a designer already has in mind at concept stage, and the producer they remember is the one who gets the call and the basis-of-design listing. Email will not rescue a weak product and it will not replace a rep. It makes sure the rep's work is not erased by six quiet months.",
  },
];

const refs = [
