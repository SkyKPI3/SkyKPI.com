---
import Sheet from '../layouts/Sheet.astro';

const people = [
  {
    name: 'Joe Lombard',
    role: 'Principal',
    bio: 'Joe leads the marketing and association work. He served on the PCI national board of directors from 2015 to 2018 and as president of PCI of Illinois & Wisconsin from 2018 to 2020. He is executive director of the Association of Licensed Architects, which Lombard Belz manages. Separately, he is employed as executive director of PCI of Illinois & Wisconsin.',
  },
  {
    name: 'Caroline Belz',
    role: 'Principal',
    bio: 'Caroline co-founded the firm after a career in nursing.',
  },
  { name: 'Beth Gaudiano', role: 'Account Manager', bio: '' },
];
---

<Sheet
  title="About Lombard Belz | Precast Marketing and Associations"
  description="Lombard Belz is a marketing and association management firm for precast concrete and AEC, run by Joe Lombard and Caroline Belz in Frankfort, Illinois."
  path="/about/"
  sheetName="About"
>
  <!-- OPEN: belief first -->
  <section class="section open">
    <div class="container open__inner">
      <p class="tag">About</p>
      <h1>About Lombard Belz.</h1>
      <p class="lede open__identity">
        Lombard Belz is a marketing and association management firm for the precast concrete and AEC industries, based in Frankfort, Illinois and working nationwide. Joe Lombard and Caroline Belz run it.
      </p>
    </div>
  </section>

  <!-- HOW THE FIRM IS BUILT -->
  <section class="section story">
    <div class="container story__grid">
      <div>
        <p class="tag reveal">The story</p>
        <h2 class="reveal">Why this firm exists</h2>
      </div>
      <div class="reveal">
        <p>
          I built Lombard Belz because of two gaps I kept watching from the
          inside. Trade associations were run by one overloaded director, with
          everything in one person's head. Industry marketing was handed to
          outside agencies that learned precast on the client's dime. I had
          lived both, and the fix looked the same from either side: a small
          team that already knows the industry.
        </p>
        <p>
          Lombard Belz manages the Association of Licensed Architects today. That daily work in the industry is what the marketing draws on.
        </p>
        <p>
          I started the firm with my wife, Caroline. She left her career as a
          nurse to build it with me.
        </p>
        <p>
          In 2026 we grew beyond the two of us and brought on our first
          employees. When you work with Lombard Belz, the people you meet are
          the people doing the work.
        </p>
      </div>
    </div>
  </section>

  <!-- PEOPLE -->
  <section class="section people">
    <div class="container people__grid">
      <div>
        <p class="tag reveal">People</p>
        <h2 class="reveal">Who does the work</h2>
      </div>
      <ul class="people__list reveal">
        {
          people.map((p) => (
            <li>
              <span class="people__name">{p.name}</span>
              <span class="people__role">{p.role}</span>
              {p.bio && <p class="people__bio">{p.bio}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>


  <!-- HOW WE DECIDE -->
  <section class="section decide">
    <div class="container">
      <p class="tag reveal">Standing rules</p>
      <h2 class="reveal">How we decide</h2>
      <ul class="decide__list">
        <li class="reveal">
          <p>
            The client list stays small on purpose. We turn down work that
            does not fit, because the right clients matter more than more
            clients.
          </p>
        </li>
        <li class="reveal">
          <p>
            We embed in a client's business and treat it like our own. We
            decline engagements where marketing is treated as a box to check.
          </p>
        </li>
        <li class="reveal">
          <p>
            Relationships come first. In this industry the people are the
            market, and the model is built on knowing them for decades rather
            than for a campaign.
          </p>
        </li>
        <li class="reveal">
          <p>
            Client work stays confidential. We name a client only with its permission.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WHERE -->
  <section class="section where">
    <div class="container where__grid">
      <div>
        <p class="tag reveal">Location</p>
        <h2 class="reveal">Where we work</h2>
      </div>
      <div class="reveal">
        <p>
          The firm is based in Frankfort, Illinois, south of Chicago, in the
          corridor where a lot of this country's precast gets made and moved.
          The team works from more than one place, and the client list has
          never been local.
        </p>
        <p>
          Our service area is the United States. Where you are has no bearing
          on whether we fit.
        </p>
        <p>
          <a class="where__link" href="mailto:hello@lombardbelz.com">hello@lombardbelz.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Contact Lombard Belz</h2>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .open {
    padding-top: var(--space-section);
  }

  .open__inner {
    max-width: 46rem;
  }

  .open__identity {
    max-width: 40rem;
  }

  .story__grid,
  .people__grid,
  .where__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .story__grid,
    .people__grid,
    .where__grid {
      grid-template-columns: 1fr;
    }
  }

  /* People: a plain list, name then role in graphite */
  .people__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 32rem;
  }

  .people__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }

  .people__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

    .people__bio {
    flex-basis: 100%;
    margin: 0.5rem 0 0;
    color: var(--graphite);
  }

  .people__name {
    font-size: 1.1rem;
  }

  .people__role {
    color: var(--graphite);
    font-size: 15px;
  }

  /* The grandfather rule: the page's centerpiece */
  .creed__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .creed__quote {
    margin: 1.5rem 0 1rem;
    max-width: 46rem;
  }

  .creed__quote p {
    margin: 0;
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .creed__meaning {
    max-width: 32rem;
    margin-top: 0.5rem;
  }

  .decide__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 44rem;
  }

  .decide__list li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .decide__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .decide__list p {
    margin: 0;
  }

  .where__link {
    color: var(--black);
    text-underline-offset: 0.15em;
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
