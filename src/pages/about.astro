---
import Sheet from '../layouts/Sheet.astro';

---

<Sheet
  title="About SkyKPI | Precast Marketing and Associations"
  description="SkyKPI is a small marketing and association management firm for precast concrete and AEC, based in Frankfort, Illinois and working nationwide."
  path="/about/"
  sheetName="About"
>
  <!-- OPEN: belief first -->
  <section class="section open">
    <div class="container open__inner">
      <p class="tag">About</p>
      <h1>About SkyKPI.</h1>
      <p class="lede open__identity">
        You work with a small team that knows precast, architecture, and construction, whether you need help marketing your company or running your association. SkyKPI is based in Frankfort, Illinois and works nationwide.
      </p>
    </div>
  </section>

  <!-- HOW THE FIRM IS BUILT -->
  <section class="section story">
    <div class="container story__grid">
      <div>
        <p class="tag reveal">What you get</p>
        <h2 class="reveal">What working with us looks like</h2>
      </div>
      <div class="reveal">
        <p>
          You get a small team that already knows precast and the building
          industry, so you do not spend your time explaining the product.
        </p>
        <p>
          You deal with the same people every month. The people you meet in
          the first conversation are the ones who write, design, photograph,
          and build.
        </p>
        <p>
          If you run a company, you get the website, email, photography, and LinkedIn work your sales team needs. If you sit on an association board, you get a full team and
          systems built around how your association works.
        </p>
      </div>
    </div>
  </section>



  <!-- HOW WE DECIDE -->
  <section class="section decide">
    <div class="container">
      <p class="tag reveal">Standing rules</p>
      <h2 class="reveal">How we decide</h2>
      <ul class="decide__list">
        <li class="reveal">
          <p>
            We limit the number of clients we take on, and we turn down work that does not fit.
          </p>
        </li>
        <li class="reveal">
          <p>
            You work directly with the people doing your marketing or running your association. We
            decline engagements where marketing is treated as a box to check.
          </p>
        </li>
        <li class="reveal">
          <p>
            Client work stays confidential. We name a client only with its permission.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WHERE -->
  <section class="section where">
    <div class="container where__grid">
      <div>
        <p class="tag reveal">Location</p>
        <h2 class="reveal">Where we work</h2>
      </div>
      <div class="reveal">
        <p>
          The firm is based in Frankfort, Illinois, south of Chicago, in the
          corridor where a lot of this country's precast gets made and moved.
          The team works from more than one place, and the client list has
          never been local.
        </p>
        <p>
          Our service area is the United States. Where you are has no bearing
          on whether we fit.
        </p>
        <p>
          <a class="where__link" href="mailto:hello@skykpi.com">hello@skykpi.com</a>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Contact SkyKPI</h2>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .open {
    padding-top: var(--space-section);
  }

  .open__inner {
    max-width: 46rem;
  }

  .open__identity {
    max-width: 40rem;
  }

  .story__grid,
  .people__grid,
  .where__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .story__grid,
    .people__grid,
    .where__grid {
      grid-template-columns: 1fr;
    }
  }

  /* People: a plain list, name then role in graphite */
  .people__list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 32rem;
  }

  .people__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }

  .people__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

    .people__bio {
    flex-basis: 100%;
    margin: 0.5rem 0 0;
    color: var(--graphite);
  }

  .people__name {
    font-size: 1.1rem;
  }

  .people__role {
    color: var(--graphite);
    font-size: 15px;
  }

  /* The grandfather rule: the page's centerpiece */
  .creed__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .creed__quote {
    margin: 1.5rem 0 1rem;
    max-width: 46rem;
  }

  .creed__quote p {
    margin: 0;
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .creed__meaning {
    max-width: 32rem;
    margin-top: 0.5rem;
  }

  .decide__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 44rem;
  }

  .decide__list li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .decide__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .decide__list p {
    margin: 0;
  }

  .where__link {
    color: var(--black);
    text-underline-offset: 0.15em;
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
