---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import { faqSchema, serviceSchema } from '../lib/schema';
import heroShot from '../assets/photos/precast/DJI_0010.JPG';
import bandShot from '../assets/photos/precast/IMG_3965.jpeg';
import webShot from '../assets/photos/precast/IMG_2417.jpeg';
import photoShot from '../assets/photos/precast/IMG_1882.JPG';
import emailShot from '../assets/photos/precast/IMG_5106.jpeg';
import socialShot from '../assets/photos/precast/IMG_2703.jpeg';

const faqs = [
  {
    q: 'Can you get us specified?',
    a: "Producers mostly don't get specified by name. They get certified, prequalified, and invited to bid, and the structure gets drawn around precast, or around somebody else's product, long before bid day. Our work is making sure the people drawing it know your plant and what it can do while that is still being decided. We don't guarantee a spec, a bid win, or a ranking for anyone. The monthly report shows what the work produced: who found you, where they came from, and what it led to.",
  },
  {
    q: 'What does a precast marketing firm do?',
    a: 'We build and run the sales tools a precast producer or supplier needs: the website, email, photography, and social presence. Everything is scoped to how precast gets specified and bought. You keep selling, and we make sure what buyers find when they look you up backs you up.',
  },
  {
    q: 'Do you work with suppliers or only producers?',
    a: 'Both. We work with producers, the suppliers who sell into them, and associate members across the industry. We also serve the architects, contractors, and subcontractors around precast.',
  },
  {
    q: 'What does precast marketing cost?',
    a: 'A monthly retainer scoped to the work, with one team and no hourly billing. Every company needs something different, so the number comes from a conversation about what you need.',
  },
  {
    q: 'Do you show client work or results?',
    a: 'Client work is confidential and we name a client only with its permission. We work as part of your team, your wins are yours, and we do not publish case studies or testimonials to sell ourselves.',
  },
  {
    q: 'Do we need to teach you the industry first?',
    a: 'No. We work in the precast industry every day. You will not pay for a ramp-up quarter or sit through glossary meetings. We already know the product and the bid calendar.',
  },
  {
    q: 'What gets built first?',
    a: 'The website and the photography, because everything else points back to them. Email and social start once there is something worth pointing people to. You will see finished work before you see a strategy deck.',
  },
  {
    q: 'Do you replace our marketing person?',
    a: 'No. Where there is someone in-house, we work alongside them and carry the load they do not have time for. Where there is nobody, we are the department. Either way you deal with the same team every month.',
  },
];

const jsonLd = [
  serviceSchema({
    name: 'Precast and AEC Marketing',
    description:
      'Websites, email, photography, and social media that get precast concrete producers and suppliers known to specifiers and buyers before jobs go out to bid, with a monthly report of who found the client and what it led to.',
    url: 'https://skykpi.com/marketing/',
    serviceType: 'Marketing services',
  }),
];

const audiences = [
  {
    href: '/architects/',
    label: 'Architects',
    copy: 'Portfolio-grade websites and marketing for firms that want their built work seen.',
  },
  {
    href: '/contractors/',
    label: 'Contractors',
    copy: 'Reputation and proof for general contractors, backing up the estimator after the meeting.',
  },
  {
    href: '/subcontractors/',
    label: 'Subcontractors',
    copy: 'Getting trade and specialty subs found and prequalified before the bid list closes.',
  },
];
---

<Sheet
  title="Precast Concrete Marketing Agency | SkyKPI"
  description="Websites, email, photography, and LinkedIn for precast producers and suppliers. One monthly retainer, one team, and a monthly report of what it produced."
  path="/marketing/"
  sheetName="Marketing"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media photo-treat">
      <div class="hero__parallax" data-parallax>
        <Image
          src={heroShot}
          alt="Aerial view of snow-dusted precast double-tee members stacked in a plant storage yard."
          widths={[480, 768, 1280, 1920, 2400]}
          width={1920}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={78}
        />
      </div>
    </div>
    <div class="container hero__content">
      <p class="tag hero__kicker">Marketing</p>
      <h1>Marketing for precast concrete producers and building product suppliers.</h1>
      <p class="lede hero__sub">
        You get one team for your website, email, plant and jobsite photography, and company LinkedIn page, so your company looks solid when an architect, engineer, or contractor looks you up. SkyKPI does this for precast concrete producers and building product suppliers. The work runs on a monthly retainer, and each month you get a one-page report listing the inquiries, sample requests, plant visits, and bid invitations we tracked.
      </p>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section problem">
    <div class="container problem__grid">
      <div>
        <p class="tag reveal">The problem</p>
        <h2 class="reveal">Why producers hire us</h2>
      </div>
      <div class="reveal">
        <p>
          Your reps walk the plant and leave a good impression.
          Then the specifier looks you up from their desk. If the website is
          ten years old and the photos are phone shots, the impression starts
          over.
        </p>
        <p>
          Most of the structure is decided during design, before the job is bid. Our work gets your plant known to the design team by then.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section class="section build">
    <div class="container">
      <p class="tag reveal">Scope of work</p>
      <h2 class="reveal">What we build</h2>

      <div class="build__grid">
        <article class="build__item reveal">
          <div class="build__media photo-treat">
            <Image
              src={webShot}
              alt="Finished embedded-brick precast panel face in raking sunlight."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <h3>The website</h3>
          <p class="dim">
            The site that backs up your reps after they leave the room. Built
            around what a specifier checks: capabilities, finishes,
            typical spans, and who to call.
          </p>
        </article>

        <article class="build__item reveal">
          <div class="build__media photo-treat">
            <Image
              src={emailShot}
              alt="Detail of a precast panel mid-lift, dark thin brick below a white fluted band."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <h3>Email between projects</h3>
          <p class="dim">
            Email keeps your name in front of the people who will pick a
            supplier the next time they have a job or a problem, and the
            report shows who opened it and who called.
          </p>
        </article>

        <article class="build__item reveal">
          <div class="build__media photo-treat">
            <Image
              src={photoShot}
              alt="A curved precast shell panel hanging from crane chains above its wooden form inside the plant."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <h3>Photography your sales team can use</h3>
          <p class="dim">
            Plant, product, and jobsite photography shot for the way it gets
            used: proposals, spec sheets, the website, and the trade-show
            booth. We never use stock.
          </p>
        </article>

        <article class="build__item reveal">
          <div class="build__media photo-treat">
            <Image
              src={socialShot}
              alt="A concrete hopper discharging fresh concrete onto a reinforced form bed in the plant."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <h3>A social presence that shows the work</h3>
          <p class="dim">
            LinkedIn first, because that is where your buyers are. Real
            projects and real people from your plant, posted consistently,
            without chasing trends.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND -->
  <section class="band photo-treat">
    <Image
      src={bandShot}
      alt="Twin elevated highway bridges on concrete piers receding over turquoise water."
      widths={[480, 768, 1280, 1920]}
        width={1920}
      sizes="100vw"
      loading="lazy"
      quality={72}
    />
  </section>

  <!-- WHO IT IS FOR -->
  <section class="section who">
    <div class="container">
      <p class="tag reveal">Who it is for</p>
      <h2 class="reveal">Who we work with</h2>
      <p class="reveal who__copy">
        The core of our work is precast producers, the suppliers who sell into
        them, and associate members across the industry. The work changes with
        the buyer.
      </p>

      <dl class="who__lanes">
        <div class="who__lane reveal">
          <dt>
            <h3>Producers</h3>
          </dt>
          <dd>
            Producers mostly are not specified by name. They get certified,
            prequalified, and invited to bid. For producers, the work is getting your capabilities in front of the people who decide which plants get invited to bid, while the structure is still being drawn.
          </dd>
        </div>
        <div class="who__lane reveal">
          <dt>
            <h3>Suppliers architects choose</h3>
          </dt>
          <dd>
            Formliners, pigments, thin brick, and finishes get picked by
            architects, so the work produces countable outcomes: spec-ready
            content, sample requests, and education bookings.
          </dd>
        </div>
        <div class="who__lane reveal">
          <dt>
            <h3>Suppliers the plant buys</h3>
          </dt>
          <dd>
            Hardware, chemicals, admixtures, and form release are rarely written into a spec section. The work is being the name the plant already
            trusts the day the current supplier ships late or a mix goes
            wrong, and the near-term outcome is earning the trial.
          </dd>
        </div>
      </dl>

      <p class="reveal who__copy">
        That fluency extends to the people who design, bid, and build with
        precast.
      </p>

      <div class="who__grid">
        {
          audiences.map((a) => (
            <a class="who__card reveal" href={a.href}>
              <h3>{a.label}</h3>
              <p class="dim">{a.copy}</p>
              <span class="textlink">{a.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODEL -->
  <section class="section model">
    <div class="container model__grid">
      <div>
        <p class="tag reveal">Engagement model</p>
        <h2 class="reveal">How pricing works</h2>
      </div>
      <div class="reveal">
        <p>
          The work runs on a monthly retainer scoped to what you need, with no hourly billing. Every company needs something different, so the retainer covers different things for different clients. You get one team that writes, designs, and shoots the photography, and one person to call.
        </p>
        <p>
          The number comes from a conversation about scope.
          <a class="model__cta" href="/contact/">Start it here.</a>
        </p>
      </div>
    </div>
  </section>

  <!-- THE MONTHLY REPORT -->
  <section class="section report">
    <div class="container report__grid">
      <div>
        <p class="tag reveal">The ledger</p>
        <h2 class="reveal">The monthly report</h2>
      </div>
      <div class="reveal">
        <p>
          The monthly report is one page. It says who found you, where they
          came from, and what it led to: the calls, the sample requests, the
          plant visits, the invitations to bid.
        </p>
        <p>
          If a month produced nothing worth reporting, the report says that too, and we talk about what changes.
        </p>
        <table class="sample">
          <caption><strong>Example report.</strong> These figures are made up to show the format. They are not client results. In a real report we separate inquiries we can trace to our work from activity your sales team reports.</caption>
          <tbody>
            <tr><th scope="row">Website inquiries</th><td>6</td><td>Four general contractors and two architects</td></tr>
            <tr><th scope="row">Sample requests</th><td>3</td><td>Two thin brick and one formliner</td></tr>
            <tr><th scope="row">Plant visits booked</th><td>1</td><td>A design team working on a parking structure</td></tr>
            <tr><th scope="row">Invitations to bid</th><td>2</td><td>Both from contractors who first replied to the email</td></tr>
            <tr><th scope="row">Email</th><td>1,240 sent</td><td>34 percent opened and three replied to sales</td></tr>
            <tr><th scope="row">LinkedIn</th><td>5 posts</td><td>2,100 views and 38 page visitors</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What plant owners ask us" />

  <Related
    links={[
      {
        href: '/associations/',
        label: 'Association management for AEC trade and professional associations',
      },
      {
        href: '/about/',
        label: 'How SkyKPI decides which clients to take',
      },
    ]}
  />

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Talk to us about your plant.</h2>
      <p class="dim reveal cta__fit">
        SkyKPI takes on a few clients at a time, all in industries we know
        firsthand. If you need a website built once, or a small monthly
        spend, we're the wrong fit, and we'll give you the name of someone
        good.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__parallax {
    position: absolute;
    inset: -18% 0 0 0;
    will-change: transform;
  }

  .hero__parallax :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.02);
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: 3rem 0 clamp(3rem, 7vw, 5rem);
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__sub {
    max-width: 36rem;
  }

  .problem__grid,
  .model__grid,
  .report__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .problem__grid,
    .model__grid,
    .report__grid {
      grid-template-columns: 1fr;
    }
  }

    .sample {
    width: 100%;
    margin-top: 2rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

    .sample caption {
    text-align: left;
    padding-bottom: 0.75rem;
  }

  .sample caption strong {
    font-weight: 500;
  }

  .sample th,
  .sample td {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-top: 1px solid var(--hairline);
    font-weight: 400;
  }

  .sample th {
    font-weight: 500;
    white-space: nowrap;
  }

  .sample td:last-child {
    color: var(--graphite);
  }

  .build__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: 2.5rem;
  }

  .build__item {
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }

  .build__media {
    aspect-ratio: 16 / 9;
    margin-bottom: 1.1rem;
  }

  .build__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .build__item h3 {
    margin: 0.5rem 0;
  }

  .build__item p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .build__grid {
      grid-template-columns: 1fr;
    }
  }

  .band {
    position: relative;
    height: clamp(16rem, 46vh, 26rem);
  }

  .band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    z-index: 3;
    text-align: center;
  }

  .who__copy {
    max-width: 40rem;
  }

  .who__lanes {
    margin: 2.25rem 0 2.5rem;
    max-width: 52rem;
  }

  .who__lane {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }

  .who__lane:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .who__lane dt {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .who__lane h3 {
    margin: 0;
  }

  .who__lane dd {
    margin: 0;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .who__lane {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  .who__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: 2.25rem;
  }

  .who__card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
  }

  .who__card h3 {
    margin: 0 0 0.35rem;
  }

  .who__card p {
    margin: 0 0 1.1rem;
  }

  @media (max-width: 820px) {
    .who__grid {
      grid-template-columns: 1fr;
    }
  }

  .model__cta {
    color: var(--black);
    text-underline-offset: 0.15em;
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__fit {
    max-width: 34rem;
    margin-bottom: 2rem;
  }
</style>
