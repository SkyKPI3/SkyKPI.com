---
import Sheet from '../../layouts/Sheet.astro';
---

<Sheet
  title="Received | Lombard Belz"
  description="Your message is in. Lombard Belz replies within one business day."
  path="/contact/thanks/"
  sheetName="Contact / Received"
  noindex={true}
>
  <section class="section thanks">
    <div class="container thanks__inner">
      <p class="tag">Contact</p>
      <h1>Received.</h1>
      <p class="lede">
        Your note is in. We will get back to you within one business day
        from hello@lombardbelz.com.
      </p>
      <a class="btn btn--ghost" href="/">Return home</a>
    </div>
  </section>
</Sheet>

<style>
  .thanks {
    min-height: 82svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }

  .thanks__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .thanks__inner .lede {
    max-width: 30rem;
    margin-bottom: 1.5rem;
  }
</style>
