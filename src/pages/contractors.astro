---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import RegistrationMarks from '../components/RegistrationMarks.astro';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../lib/schema';
import heroShot from '../assets/photos/arch/IMG_5326.jpeg';
import detailShot from '../assets/photos/arch/IMG_5108.jpeg';

const faqs = [
  {
    q: 'What should a general contractor’s website show?',
    a: 'What the owner’s rep checks before the interview: finished projects, delivery methods, markets you build in, bonding capacity if you publish it, safety culture, and the people who run the work. Real jobsite photography, not renderings.',
  },
  {
    q: 'Do you actually understand construction?',
    a: 'Our core expertise is the precast concrete industry, so we live around structures, schedules, and jobsites. We know the difference between a superintendent and a PM, and the marketing we build for GCs reads like it was written by someone who does.',
  },
  {
    q: 'What does marketing for a GC cost?',
    a: 'A single monthly retainer scoped to the work, with one team on the account and no hourly billing. The number comes out of a conversation about what you need, and we will tell you plainly what we would do for it.',
  },
];

const jsonLd = [faqSchema(faqs)];
---

<Sheet
  title="Marketing and Websites for General Contractors | SkyKPI"
  description="SkyKPI builds websites, marketing, and social media for general contractors, with core expertise in the precast concrete industry."
  path="/contractors/"
  sheet="A-220"
  sheetName="Contractors"
  parent={{ href: "/marketing/", label: "Marketing" }}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A bridge jobsite in autumn with new concrete abutments in the foreground and a crawler crane down the haul road."
        widths={[480, 768, 1280, 1920]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <RegistrationMarks />
    <div class="container hero__content">
      <p class="tag hero__kicker">Sheet A-220 &middot; Marketing / Contractors</p>
      <h1>Reputation wins the work. Proof backs it up.</h1>
      <hr class="dimline" aria-hidden="true" />
      <p class="lede hero__sub">
        SkyKPI builds websites, marketing, and social media for general
        contractors, with core expertise in the precast concrete industry.
      </p>
    </div>
  </section>

  <section class="section sheet-dark angle">
    <div class="container angle__grid">
      <div>
        <p class="tag reveal">Why us</p>
        <h2 class="reveal">The lookup happens after the meeting.</h2>
        <hr class="dimline reveal" aria-hidden="true" />
      </div>
      <div class="reveal">
        <p>
          A GC gets shortlisted on relationships and reputation. Then someone
          on the owner's side looks the firm up. What they find either backs
          up your estimator and your business development lead, or it
          undercuts them.
        </p>
        <p>
          We build the version that backs them up: finished projects, real
          jobsite photography, and a firm that looks like it builds what it
          says it builds.
        </p>
      </div>
    </div>
  </section>

  <section class="section sheet-dark sheet-dark--deep scope">
    <RegistrationMarks />
    <div class="container scope__grid">
      <div class="scope__list">
        <p class="tag reveal">Scope of work</p>
        <h2 class="reveal">What we build for GCs</h2>
        <hr class="dimline reveal" aria-hidden="true" />
        <ul>
          <li class="reveal">
            <span class="tag tag--dim">W-1</span>
            <h3>The website that survives diligence</h3>
            <p class="dim">
              Project pages, markets, delivery methods, and leadership. The
              answers an owner's rep wants, findable in two clicks.
            </p>
          </li>
          <li class="reveal">
            <span class="tag tag--dim">W-2</span>
            <h3>Jobsite photography</h3>
            <p class="dim">
              Real crews on real sites. Photography that makes your safety
              culture and your self-perform work visible.
            </p>
          </li>
          <li class="reveal">
            <span class="tag tag--dim">W-3</span>
            <h3>A presence owners notice</h3>
            <p class="dim">
              LinkedIn and email that keep the firm in front of owners,
              developers, and the architects who recommend builders.
            </p>
          </li>
        </ul>
      </div>
      <div class="scope__media photo-treat reveal">
        <Image
          src={detailShot}
          alt="A mobile crane hoisting rigging above a braced concrete wall panel while workers watch from below."
          widths={[360, 480, 800, 1200]}
          width={1200}
          sizes="(min-width: 821px) 40vw, 100vw"
          loading="lazy"
          quality={72}
        />
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What GCs ask us" />

  <section class="section sheet-dark cta">
    <div class="container cta__inner">
      <p class="tag reveal">Sheet A-500</p>
      <h2 class="reveal">Give your estimator some backup.</h2>
      <hr class="dimline dimline--center reveal" aria-hidden="true" />
      <div class="reveal">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  .hero {
    position: relative;
    min-height: 72svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: calc(var(--header-h) + 3rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__sub {
    max-width: 34rem;
  }

  .angle__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .scope__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .scope__list ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .scope__list li {
    border-top: 1px solid var(--hairline-on-ink);
    padding: 1.25rem 0;
  }

  .scope__list h3 {
    margin: 0.5rem 0;
  }

  .scope__list p {
    margin: 0;
  }

  .scope__media {
    aspect-ratio: 3 / 4;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .scope__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .angle__grid,
    .scope__grid {
      grid-template-columns: 1fr;
    }

    .scope__media {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }

  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
