---
import Sheet from '../layouts/Sheet.astro';
import Related from '../components/Related.astro';

const checks = [
  { name: 'Found by search', copy: 'The site shows up when an architect searches the product or category, not only the company name.' },
  { name: 'Answers first', copy: 'The first paragraph of each product page says what the product is, what it comes in and who it is for.' },
  { name: 'Details in the page', copy: 'Sizes, finishes, spans and details are on the page as text, not locked in a PDF.' },
  { name: 'Fast on a phone', copy: 'The page loads and settles in under three seconds on a mid-range phone.' },
  { name: 'Open to AI assistants', copy: 'The site allows the crawlers that ChatGPT, Claude and Perplexity use to read and quote it.' },
  { name: 'Real projects', copy: 'Finished work is shown with photos and a sentence on the project, not stock images.' },
  { name: 'Who to call', copy: 'A named person or a working form is one click away on every page.' },
  { name: 'Still alive', copy: 'Something on the site has changed in the last year.' },
];
---

<Sheet
  title="The State of Precast Marketing, an Annual Report | SkyKPI"
  description="SkyKPI grades the websites of precast concrete producers every year on eight things an architect needs, and publishes the results. First edition in progress."
  path="/report/"
  sheetName="Report"
>
  <section class="section open">
    <div class="container open__grid">
      <div>
        <p class="tag">Annual report</p>
        <h1>The State of Precast Marketing.</h1>
        <p class="lede">
          Every year we grade the public websites of precast concrete producers across the United States on the eight things an architect needs from them, and we publish what we find. The first edition is in progress. Leave your email and we will send it when it is out.
        </p>
        <form class="signup" name="report" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="report" />
          <p class="hp" aria-hidden="true">
            <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="signup__row">
            <div class="field">
              <label for="r-email">Email</label>
              <input id="r-email" name="email" type="email" required maxlength="200" autocomplete="email" />
            </div>
            <div class="field">
              <label for="r-company">Company</label>
              <input id="r-company" name="company" type="text" maxlength="160" autocomplete="organization" />
            </div>
          </div>
          <button class="btn" type="submit">Send me the report</button>
          <p class="dim signup__note">One email when it is published. Nothing else.</p>
        </form>
      </div>
      <div class="cover" aria-hidden="true">
        <div class="cover__inner">
          <p class="cover__kicker">SkyKPI</p>
          <p class="cover__title">The State of Precast Marketing</p>
          <p class="cover__sub">How producer websites measure up against what architects need</p>
          <p class="cover__edition">First edition</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="rule reveal"></span>
      <p class="tag reveal">What we grade</p>
      <h2 class="reveal">Eight checks, graded the same way for every producer</h2>
      <p class="reveal">Each check comes from what architects told the AIA they need, or from how search engines and AI assistants read a page. Every site gets the same checks, run the same way.</p>
      <ol class="checks">
        {checks.map((c, i) => (
          <li class="reveal">
            <span class="checks__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{c.name}</h3>
              <p class="dim">{c.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section on-navy why">
    <div class="container split">
      <div>
        <span class="rule reveal"></span>
        <p class="tag reveal">Why we publish it</p>
        <h2 class="reveal">So producers can see where they stand, and fix it.</h2>
      </div>
      <div class="reveal">
        <p>The report names no producer. It shows how the industry scores on each check, what the best sites do, and what a producer can change this quarter.</p>
        <p>If you want your own site scored before the report is out, write to us and we will run the eight checks and send you the results.</p>
        <a class="btn" href="/contact/">Score my site</a>
      </div>
    </div>
  </section>

  <Related
    links={[
      { href: '/guides/how-precast-gets-specified/', label: 'Guide: how precast gets specified, and where producers fall out of the running' },
      { href: '/manufacturers/', label: 'Marketing for precast producers and building-product manufacturers' },
    ]}
  />
</Sheet>

<style>
  .open__grid {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .signup {
    margin-top: 2rem;
    max-width: 36rem;
  }

  .signup__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .field label {
    display: block;
    font-size: 14px;
    color: var(--graphite);
    margin-bottom: 0.35rem;
  }

  .field input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 16px;
    border: 1px solid var(--hairline);
    background: var(--white);
    color: var(--text);
  }

  .field input:focus {
    outline: 2px solid var(--teal-text);
    outline-offset: 1px;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .signup__note {
    margin-top: 0.75rem;
    font-size: 14px;
  }

  /* Report cover, drawn in CSS */
  .cover {
    aspect-ratio: 8.5 / 11;
    max-width: 22rem;
    margin-inline: auto;
    background: var(--navy);
    box-shadow: 0 30px 50px -30px rgba(13, 41, 88, 0.6);
    display: flex;
  }

  .cover__inner {
    margin: auto 2rem 2rem;
    border-top: 4px solid var(--teal);
    padding-top: 1.25rem;
    color: var(--white);
  }

  .cover__kicker {
    margin: 0 0 1.5rem;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--graphite-on-black);
  }

  .cover__title {
    margin: 0 0 0.75rem;
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .cover__sub {
    margin: 0 0 1.5rem;
    font-size: 14px;
    color: var(--graphite-on-black);
  }

  .cover__edition {
    margin: 0;
    font-size: 13px;
    color: var(--white);
  }

  .checks {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(1.5rem, 4vw, 4rem);
  }

  .checks li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }

  .checks__n {
    color: var(--teal-text);
    font-size: 15px;
    padding-top: 0.2rem;
  }

  .checks h3 {
    margin-bottom: 0.3rem;
  }

  .checks p {
    margin: 0;
  }

  .why p {
    color: var(--white);
  }

  .why .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 820px) {
    .open__grid,
    .checks,
    .signup__row {
      grid-template-columns: 1fr;
    }

    .cover {
      max-width: 16rem;
    }
  }
</style>
