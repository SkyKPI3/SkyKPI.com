---
import Sheet from '../layouts/Sheet.astro';
---

<Sheet
  title="Page Not Found | Lombard Belz"
  description="This page is not on the site. Return to the home page."
  path="/404/"
  sheetName="Not found"
  noindex={true}
>
  <section class="section nf">
    <div class="container nf__inner">
      <p class="tag">Not found</p>
      <h1>Page not found.</h1>
      <p class="lede">
        This page is not on the site. It may have moved in the last update.
        Start again from the home page.
      </p>
      <a class="btn" href="/">Return home</a>
    </div>
  </section>
</Sheet>

<style>
  .nf {
    min-height: 82svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
  }

  .nf__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .nf__inner .lede {
    max-width: 30rem;
    margin-bottom: 1.5rem;
  }
</style>
