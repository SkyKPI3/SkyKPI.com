---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import heroShot from '../assets/photos/precast/IMG_4084.jpeg';
import marketingDoor from '../assets/photos/precast/dji_fly_20260423_122348_0032_1778523760766_photo.jpg';
import associationsDoor from '../assets/photos/assoc/IMG_1978.jpeg';

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Lombard Belz',
  legalName: 'SkyKPI LLC',
  url: 'https://lombardbelz.com',
  description:
    'Lombard Belz is a marketing and association management firm for the precast concrete and AEC industries, based in Frankfort, Illinois and working nationwide. The marketing work covers websites, email, photography, and LinkedIn for precast producers and suppliers, with a monthly report of who found the client and what it led to. The association work covers events, membership, sponsors, communications, and board support for AEC trade associations.',
  email: 'hello@lombardbelz.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frankfort',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  areaServed: 'United States',
  knowsAbout: [
    'Precast concrete industry',
    'AEC marketing',
    'Trade association management',
  ],
  sameAs: ['https://www.linkedin.com/company/skykpi/'],
};
---

<Sheet
  title="Precast Marketing and Association Management | Lombard Belz"
  description="Lombard Belz provides websites, email, photography, and LinkedIn marketing for precast producers and suppliers, and manages AEC trade associations."
  path="/"
  sheetName="Home"
  jsonLd={[professionalService]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A mobile crane sets a precast concrete bridge girder onto a pier cap at a highway jobsite."
        widths={[480, 768, 1280, 1920, 2400]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <div class="container hero__content">
      <p class="tag hero__label">Lombard Belz</p>
      <h1>Marketing and association management for precast concrete and AEC.</h1>
      <p class="lede hero__identity">
        Lombard Belz provides websites, email marketing, photography, and LinkedIn marketing for precast concrete producers and building product suppliers, so architects, engineers, and contractors know your company before a job is bid. We also manage trade associations in precast and AEC, so your board gets a full team and systems built around how your association works.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/contact/">Contact us</a>
        <a class="textlink hero__link" href="/marketing/">Marketing</a>
        <a class="textlink hero__link" href="/associations/">Association management</a>
      </div>
    </div>
  </section>

  <!-- TWO DOORS -->
  <section class="section doors">
    <div class="container">
      <p class="tag reveal">Services</p>
      <h2 class="reveal">
        What we do
      </h2>

      <div class="cols cols--2">
        <a class="door reveal" href="/marketing/">
          <div class="door__media">
            <Image
              src={marketingDoor}
              alt="Rows of prestressed concrete bridge girders stored in a precast plant yard."
              widths={[360, 480, 800, 1200]}
              width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <p class="tag">Marketing</p>
          <h3>Marketing for precast producers and suppliers</h3>
          <p class="dim">
            Websites, email, photography, and social media for precast
            producers and suppliers, and for the architects, contractors,
            and subcontractors around them.
          </p>
          <span class="textlink">Marketing</span>
        </a>

        <a class="door reveal" href="/associations/">
          <div class="door__media">
            <Image
              src={associationsDoor}
              alt="Association members seated at round tables in a historic ballroom while a speaker presents from the stage."
              widths={[360, 480, 800, 1200]}
              width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <p class="tag">Association management</p>
          <h3>Association management for AEC trade associations</h3>
          <p class="dim">
            We build the website, membership, and event systems in house so the association is not tied to a template, and one team runs events, membership, sponsors, communications, and board support for one fee.
          </p>
          <span class="textlink">Association management</span>
        </a>
      </div>
    </div>
  </section>

  <!-- INSIDER ANGLE -->
  <section class="section insider">
    <div class="container split">
      <div>
        <p class="tag reveal">Industry experience</p>
        <h2 class="reveal">
          We already work in precast.
        </h2>
      </div>
      <div class="insider__copy reveal">
        <p>
          We work in precast and AEC every day, so we come to the first meeting already knowing the products, the kinds of buyers, and how the bid calendar runs. You will not have to teach us what a double tee is.
        </p>
        <p>
          Most structural and material decisions get made during design, well before a job is bid. Our work puts your plant in front of architects, engineers, and contractors during that window, and the monthly report shows what it produced.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section how">
    <div class="container">
      <p class="tag reveal">How we work</p>
      <h2 class="reveal">How an engagement works</h2>
      <ol class="cols cols--3 how__steps">
        <li class="reveal">
          <h3>1. Scope</h3>
          <p class="dim">
            It starts with one conversation about what you need. We tell you
            plainly what we would do and what it costs.
          </p>
        </li>
        <li class="reveal">
          <h3>2. Build</h3>
          <p class="dim">
            One team writes, designs, and shoots the photography. You review finished work.
          </p>
        </li>
        <li class="reveal">
          <h3>3. Run</h3>
          <p class="dim">
            The program runs on a single monthly retainer scoped to the work,
            and a one-page monthly report lists the inquiries, sample requests, plant visits, and bid invitations we tracked.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- STANDING RULES -->
  <section class="section notes">
    <div class="container">
      <p class="tag reveal">Standing rules</p>
      <ul class="notes__list">
        <li class="reveal">
          <p>
            Client work is confidential. We name a client only with its permission.
          </p>
        </li>
        <li class="reveal">
          <p>
            The people you meet in the first conversation do the work.
          </p>
        </li>
        <li class="reveal">
          <p>
            Precast is our core. The work we do for architects, contractors, and subcontractors builds on it.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Contact Lombard Belz</h2>
      <p class="dim reveal cta__copy">
        Send a note about what you need to sell, or what your board needs
        handled. We will tell you whether we are the right fit.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: 4rem 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero__label {
    margin-bottom: 1.5rem;
  }

  .hero__content h1 {
    max-width: 22ch;
  }

  .hero__identity {
    max-width: 36rem;
    margin-top: 1.5rem;
  }

    .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .hero__link {
    color: inherit;
  }

  /* DOORS: two plain columns with a hairline top rule */
  .door {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .door__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .door__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .door h3 {
    margin-bottom: 0.6rem;
  }

  .door .dim {
    margin-bottom: 1.25rem;
  }

  .door .textlink {
    margin-top: auto;
    align-self: flex-start;
  }

  /* HOW */
  .how__steps h3 {
    margin: 0 0 0.5rem;
  }

  .how__steps p {
    margin: 0;
  }

  /* STANDING RULES */
  .notes__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-width: 44rem;
  }

  .notes__list li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .notes__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .notes__list p {
    margin: 0;
  }

  /* CTA */
  .cta__inner {
    max-width: 44rem;
  }

  .cta__copy {
    margin-bottom: 2rem;
  }
</style>
