---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import heroShot from '../assets/photos/precast/IMG_2438.jpeg';
import marketingDoor from '../assets/photos/precast/dji_fly_20260423_122348_0032_1778523760766_photo.jpg';
import associationsDoor from '../assets/photos/assoc/IMG_1978.jpeg';

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Lombard Belz',
  legalName: 'SkyKPI LLC',
  url: 'https://lombardbelz.com',
  description:
    'Lombard Belz is a marketing and association management firm for the precast concrete and AEC industries, based in Frankfort, Illinois and working nationwide. The marketing work gets precast producers and suppliers known to the people who decide what gets designed in and what gets bought, before jobs go out to bid, with a monthly report of who found the client and what it led to.',
  email: 'hello@lombardbelz.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frankfort',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  areaServed: 'United States',
  knowsAbout: [
    'Precast concrete industry',
    'AEC marketing',
    'Trade association management',
  ],
  sameAs: ['https://www.linkedin.com/company/skykpi/'],
};
---

<Sheet
  title="Lombard Belz | Marketing and Association Management for Precast and AEC"
  description="By the time a job goes out to bid, the big decisions are already made. Lombard Belz gets precast producers and suppliers known to the people making them."
  path="/"
  sheetName="Home"
  jsonLd={[professionalService]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A straddle carrier lifts a long precast wall panel across a muddy plant yard under a clear winter sky."
        widths={[480, 768, 1280, 1920, 2400]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <div class="container hero__content">
      <p class="tag hero__label">Lombard Belz</p>
      <h1>By the time a job goes out to bid, the big decisions are already made.</h1>
      <p class="lede hero__identity">
        Lombard Belz gets precast producers and suppliers known to the architects,
        engineers, and contractors making those decisions, while there is
        still time to shape them. Every month you see who found you and what
        it put on your books.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>

  <!-- TWO DOORS -->
  <section class="section doors">
    <div class="container">
      <p class="tag reveal">Scope of work</p>
      <h2 class="reveal">
        Lombard Belz does marketing and association management for precast and AEC,
        from inside the industry.
      </h2>

      <div class="cols cols--2">
        <a class="door reveal" href="/marketing/">
          <div class="door__media">
            <Image
              src={marketingDoor}
              alt="Rows of prestressed concrete bridge girders stored in a precast plant yard."
              widths={[360, 480, 800, 1200]}
              width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <p class="tag">Marketing</p>
          <h3>Lombard Belz works as an extension of your sales team.</h3>
          <p class="dim">
            Websites, email, photography, and social media for precast
            producers and suppliers, and for the architects, contractors,
            and subcontractors around them.
          </p>
          <span class="textlink">Marketing</span>
        </a>

        <a class="door reveal" href="/associations/">
          <div class="door__media">
            <Image
              src={associationsDoor}
              alt="Association members seated at round tables in a historic ballroom while a speaker presents from the stage."
              widths={[360, 480, 800, 1200]}
              width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <p class="tag">Association management</p>
          <h3>The association gets a full team for one fee.</h3>
          <p class="dim">
            Events, membership, sponsors, communications, and board support
            for AEC trade and professional associations that have outgrown
            the single-director model.
          </p>
          <span class="textlink">Association management</span>
        </a>
      </div>
    </div>
  </section>

  <!-- INSIDER ANGLE -->
  <section class="section insider">
    <div class="container split">
      <div>
        <p class="tag reveal">Why it works</p>
        <h2 class="reveal">
          You should never have to explain your industry to your marketing
          firm.
        </h2>
      </div>
      <div class="insider__copy reveal">
        <p>
          We already know what architects search for and when bid season
          hits. Nobody spends the first six months
          learning what a double tee is, and the first draft sounds like your
          industry because we work in it every day.
        </p>
        <p>
          The work is getting you known to the people making the decisions
          while there is still time to shape them, and the monthly report
          shows what it produced.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section how">
    <div class="container">
      <p class="tag reveal">How we work</p>
      <h2 class="reveal">Scope, build, run.</h2>
      <ol class="cols cols--3 how__steps">
        <li class="reveal">
          <h3>Scope</h3>
          <p class="dim">
            It starts with one conversation about what you need. We tell you
            plainly what we would do and what it costs.
          </p>
        </li>
        <li class="reveal">
          <h3>Build</h3>
          <p class="dim">
            One team writes, designs, and shoots. You review real work, not a
            process deck.
          </p>
        </li>
        <li class="reveal">
          <h3>Run</h3>
          <p class="dim">
            The program runs on a single monthly retainer scoped to the work,
            and the monthly report shows who found you and what it led to.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- STANDING RULES -->
  <section class="section notes">
    <div class="container">
      <p class="tag reveal">Standing rules</p>
      <ul class="notes__list">
        <li class="reveal">
          <p>
            Client work is confidential. We publish no names and no case
            studies. Your wins are yours.
          </p>
        </li>
        <li class="reveal">
          <p>
            The people you meet do the work. There is no junior account team
            waiting behind the pitch.
          </p>
        </li>
        <li class="reveal">
          <p>
            Precast is the flagship. Our work for architects, contractors, and
            subcontractors is built on that fluency.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta__inner">
      <h2 class="reveal">Tell us what you are working on.</h2>
      <p class="dim reveal cta__copy">
        Send a note about what you need to sell, or what your board needs
        handled. We will tell you straight whether we are the right fit.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: 4rem 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero__label {
    margin-bottom: 1.5rem;
  }

  .hero__content h1 {
    max-width: 18ch;
  }

  .hero__identity {
    max-width: 36rem;
    margin-top: 1.5rem;
  }

  .hero__cta {
    margin-top: 2rem;
  }

  /* DOORS: two plain columns with a hairline top rule */
  .door {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .door__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .door__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .door h3 {
    margin-bottom: 0.6rem;
  }

  .door .dim {
    margin-bottom: 1.25rem;
  }

  .door .textlink {
    margin-top: auto;
    align-self: flex-start;
  }

  /* HOW */
  .how__steps h3 {
    margin: 0 0 0.5rem;
  }

  .how__steps p {
    margin: 0;
  }

  /* STANDING RULES */
  .notes__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-width: 44rem;
  }

  .notes__list li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .notes__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .notes__list p {
    margin: 0;
  }

  /* CTA */
  .cta__inner {
    max-width: 44rem;
  }

  .cta__copy {
    margin-bottom: 2rem;
  }
</style>
