---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import RegistrationMarks from '../components/RegistrationMarks.astro';
import heroShot from '../assets/photos/precast/IMG_2438.jpeg';
import marketingDoor from '../assets/photos/precast/dji_fly_20260423_122348_0032_1778523760766_photo.jpg';
import associationsDoor from '../assets/photos/assoc/IMG_1978.jpeg';

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SkyKPI LLC',
  url: 'https://skykpi.com',
  description:
    'SkyKPI is a marketing and association management firm for the precast concrete and AEC industries, based in Frankfort, Illinois. The marketing work gets precast producers and suppliers known to the people who decide what gets designed in and what gets bought, before jobs go out to bid, with a monthly report of who found the client and what it led to.',
  email: 'hello@skykpi.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frankfort',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  areaServed: 'United States',
  knowsAbout: [
    'Precast concrete industry',
    'AEC marketing',
    'Trade association management',
  ],
  sameAs: ['https://www.linkedin.com/company/skykpi/'],
};
---

<Sheet
  title="SkyKPI | Marketing and Association Management for Precast and AEC"
  description="By the time a job goes out to bid, the big decisions are already made. SkyKPI gets precast producers and suppliers known to the people making them."
  path="/"
  sheet="A-100"
  sheetName="Home"
  jsonLd={[professionalService]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media photo-treat">
      <div class="hero__parallax" data-parallax>
        <Image
          src={heroShot}
          alt="A straddle carrier lifts a long precast wall panel across a muddy plant yard under a clear winter sky."
          widths={[480, 768, 1280, 1920, 2400]}
          width={1920}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={78}
        />
      </div>
    </div>
    <RegistrationMarks />
    <div class="container hero__content">
      <p class="tag hero__kicker">SkyKPI LLC &middot; Frankfort, Illinois</p>
      <h1>
        By the time a job goes out to bid, <span class="hero__accent">the big decisions are already made.</span>
      </h1>
      <hr class="dimline" aria-hidden="true" />
      <p class="lede hero__identity">
        SkyKPI gets precast producers and suppliers known to the architects,
        engineers, and contractors making those decisions, while there is
        still time to shape them. Every month you see who found you and what
        it put on your books.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>

  <!-- TWO DOORS -->
  <section class="section sheet doors">
    <div class="container">
      <p class="tag reveal">Scope of work</p>
      <h2 class="reveal">
        SkyKPI does marketing and association management for precast and AEC,
        from inside the industry.
      </h2>
      <hr class="dimline reveal" aria-hidden="true" />

      <div class="doors__grid">
        <a class="door reveal" href="/marketing/">
          <div class="door__head">
            <span class="tag tag--dim">Sheet A-200</span>
            <span class="tag">Marketing</span>
          </div>
          <div class="door__media photo-treat">
            <Image
              src={marketingDoor}
              alt="Rows of prestressed concrete bridge girders stored in a precast plant yard."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <div class="door__body">
            <h3>SkyKPI works as an extension of your sales team.</h3>
            <p class="dim">
              Websites, email, photography, and social media for precast
              producers and suppliers, and for the architects, contractors,
              and subcontractors around them.
            </p>
            <span class="door__link tag">Open sheet A-200 &rarr;</span>
          </div>
        </a>

        <a class="door reveal" href="/associations/">
          <div class="door__head">
            <span class="tag tag--dim">Sheet A-300</span>
            <span class="tag">Association Management</span>
          </div>
          <div class="door__media photo-treat">
            <Image
              src={associationsDoor}
              alt="Association members seated at round tables in a historic ballroom while a speaker presents from the stage."
              widths={[360, 480, 800, 1200]}
          width={1200}
              sizes="(min-width: 821px) 50vw, 100vw"
              loading="lazy"
              quality={72}
            />
          </div>
          <div class="door__body">
            <h3>The association gets a full team for one fee.</h3>
            <p class="dim">
              Events, membership, sponsors, communications, and board support
              for AEC trade and professional associations that have outgrown
              the single-director model.
            </p>
            <span class="door__link tag">Open sheet A-300 &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- INSIDER ANGLE -->
  <section class="section sheet sheet--mist insider">
    <RegistrationMarks />
    <div class="container insider__grid">
      <div>
        <p class="tag reveal">Why it works</p>
        <h2 class="reveal">
          You should never have to explain your industry to your marketing
          firm.
        </h2>
        <hr class="dimline reveal" aria-hidden="true" />
      </div>
      <div class="insider__copy reveal">
        <p>
          We already know what architects search for, how specs get written,
          and when bid season hits. Nobody spends the first six months
          learning what a double tee is, and the first draft sounds like your
          industry because we work in it every day.
        </p>
        <p>
          The work is getting you known to the people making the decisions
          while there is still time to shape them, and the monthly report
          shows what it produced.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section sheet how">
    <div class="container">
      <p class="tag reveal">Sequence of operations</p>
      <h2 class="reveal">How we work</h2>
      <hr class="dimline reveal" aria-hidden="true" />
      <ol class="how__steps">
        <li class="reveal">
          <span class="tag tag--dim">01</span>
          <h3>Scope</h3>
          <p class="dim">
            One conversation about what you need. We tell you plainly what we
            would do and what it costs.
          </p>
        </li>
        <li class="reveal">
          <span class="tag tag--dim">02</span>
          <h3>Build</h3>
          <p class="dim">
            One team writes, designs, and shoots. You review real work, not a
            process deck.
          </p>
        </li>
        <li class="reveal">
          <span class="tag tag--dim">03</span>
          <h3>Run</h3>
          <p class="dim">
            The program runs on a single monthly retainer scoped to the work,
            and the monthly report shows who found you and what it led to.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- GENERAL NOTES -->
  <section class="section sheet sheet--mist notes">
    <div class="container">
      <p class="tag reveal">General notes</p>
      <ul class="notes__list">
        <li class="reveal">
          <span class="tag tag--dim">G1</span>
          <p>
            Client work is confidential. No names, no case studies, no borrowed
            credit. Your wins are yours.
          </p>
        </li>
        <li class="reveal">
          <span class="tag tag--dim">G2</span>
          <p>
            The people you meet do the work. There is no junior account team
            waiting behind the pitch.
          </p>
        </li>
        <li class="reveal">
          <span class="tag tag--dim">G3</span>
          <p>
            Precast is the flagship. Our work for architects, contractors, and
            subcontractors is built on that fluency.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section sheet cta">
    <RegistrationMarks />
    <div class="container cta__inner">
      <p class="tag reveal">Sheet A-500</p>
      <h2 class="reveal">Tell us what you are working on.</h2>
      <hr class="dimline dimline--center reveal" aria-hidden="true" />
      <p class="dim reveal cta__copy">
        Send a note about what you need to sell, or what your board needs
        handled. We will tell you straight whether we are the right fit.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Start the conversation</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__parallax {
    position: absolute;
    inset: -18% 0 0 0;
    will-change: transform;
  }

  .hero__parallax :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.02);
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: calc(var(--header-h) + 3rem) 0 clamp(3.5rem, 8vw, 6rem);
  }

  .hero__kicker {
    margin-bottom: 1.4rem;
  }

  .hero__accent {
    color: var(--teal);
  }

  .hero__identity {
    max-width: 34rem;
  }

  .hero__cta {
    margin-top: 2rem;
  }

  /* DOORS */
  .doors__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: 2.5rem;
  }

  .door {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--hairline-on-ink);
    background: var(--surface);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .door:hover {
    border-color: var(--teal);
    transform: translateY(-3px);
  }

  .door__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--hairline-on-ink);
  }

  .door__media {
    aspect-ratio: 16 / 9;
  }

  .door__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .door__body {
    padding: 1.5rem 1.25rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .door__body h3 {
    margin-bottom: 0.35rem;
  }

  .door__body p {
    margin-bottom: 1.1rem;
  }

  .door__link {
    margin-top: auto;
    transition: color 0.2s ease;
  }

  .door:hover .door__link {
    color: var(--text-on-ink);
  }

  @media (max-width: 820px) {
    .doors__grid {
      grid-template-columns: 1fr;
    }
  }

  /* INSIDER */
  .insider__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .insider__copy p {
    font-size: 1.05rem;
  }

  @media (max-width: 820px) {
    .insider__grid {
      grid-template-columns: 1fr;
    }
  }

  /* HOW */
  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .how__steps li {
    border-top: 1px solid var(--hairline-on-ink);
    padding-top: 1.25rem;
  }

  .how__steps h3 {
    margin: 0.5rem 0;
  }

  .how__steps p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .how__steps {
      grid-template-columns: 1fr;
    }
  }

  /* NOTES */
  .notes__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 44rem;
  }

  .notes__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline-on-ink);
  }

  .notes__list li:last-child {
    border-bottom: 1px solid var(--hairline-on-ink);
  }

  .notes__list p {
    margin: 0;
  }

  /* CTA */
  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__copy {
    max-width: 32rem;
    margin-bottom: 2rem;
  }
</style>
