---
import { Image } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import heroShot from '../assets/photos/precast/IMG_4084.jpeg';

const services = [
  {
    href: '/manufacturers/',
    tag: 'Marketing',
    title: 'Marketing for manufacturers and subcontractors',
    copy: 'Your website, search, photography, email and LinkedIn run as one program on a monthly retainer, with a one-page report each month.',
  },
  {
    href: '/associations/',
    tag: 'Association management',
    title: 'Association management',
    copy: 'A full team for events, membership, sponsors, communications and board support, running on membership software we build and maintain.',
  },
  {
    href: '/custom-systems/',
    tag: 'Custom systems',
    title: 'Online payments, portals and association software',
    copy: 'When a website is not enough, we build the system behind it: member and customer portals, online payments and association management software.',
  },
  {
    href: '/architects/',
    tag: 'Fixed-price websites',
    title: 'Websites for architects and local businesses',
    copy: 'Fixed-price websites for architecture firms and for businesses in Frankfort, New Lenox and Mokena, with a low monthly care plan.',
  },
];
---

<Sheet
  title="Websites and Marketing for Precast and Building-Product Manufacturers | SkyKPI"
  description="SkyKPI builds websites architects can use, runs marketing for precast and building-product manufacturers, manages associations and builds custom portals."
  path="/"
  sheetName="Home"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media photo-treat">
      <Image
        src={heroShot}
        alt="A mobile crane sets a precast concrete bridge girder onto a pier cap at a highway jobsite."
        widths={[480, 768, 1280, 1920, 2400]}
        width={1920}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
    </div>
    <div class="container hero__content">
      <p class="tag hero__label">For precast and building-product manufacturers</p>
      <h1>Websites architects can use to choose your product.</h1>
      <p class="lede hero__identity">
        Architects start with a search and then go to the manufacturer's own website. SkyKPI builds those websites and runs the marketing around them. We also manage associations and build member and customer portals for the industry. Based in Frankfort, Illinois, working nationwide.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/contact/">Contact us</a>
        <a class="textlink" href="/pricing/">See pricing</a>
      </div>
    </div>
  </section>

  <!-- WHAT ARCHITECTS DO -->
  <section class="section on-navy facts">
    <div class="container">
      <span class="rule reveal"></span>
      <p class="tag reveal">What architects told the AIA</p>
      <h2 class="reveal">The website is where an architect decides whether to keep looking.</h2>
      <ul class="facts__list">
        <li class="reveal"><strong>71%</strong><span>start product research by searching for the product or category.</span></li>
        <li class="reveal"><strong>74%</strong><span>leave a manufacturer's website if they cannot find what they need within a few clicks.</span></li>
        <li class="reveal"><strong>20%</strong><span>rate manufacturers well on ease of navigation. 87% say it matters.</span></li>
      </ul>
      <p class="facts__note reveal">
        We build a manufacturer's website around the questions an architect asks first: sizes, finishes, details, and who to call.
      </p>
      <p class="source reveal">
        Source: The American Institute of Architects, <a href="https://www.constructconnect.com/hubfs/Architects%20Journey%20to%20Specification/2018%20The%20Architects%20Journey%20to%20Specification%20Full%20Report%202nd%20Edition.pdf" rel="noopener">The Architect's Journey to Specification</a>, 2018. Survey of 400 architects.
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services">
    <div class="container">
      <p class="tag reveal">Services</p>
      <h2 class="reveal">What we do</h2>
      <div class="services__grid">
        {
          services.map((s) => (
            <a class="service reveal" href={s.href}>
              <p class="tag">{s.tag}</p>
              <h3>{s.title}</h3>
              <p class="dim">{s.copy}</p>
              <span class="textlink">Read more</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHAT WE RUN -->
  <section class="section on-mist run">
    <div class="container split">
      <div>
        <span class="rule reveal"></span>
        <p class="tag reveal">What we run</p>
        <h2 class="reveal">We use what we build, every day.</h2>
      </div>
      <ul class="run__list">
        <li class="reveal">
          <h3>A membership system for a professional association</h3>
          <p class="dim">Sign-in, renewals, event registration, continuing education credits, a job board and membership certificates. Staff and members use it daily.</p>
        </li>
        <li class="reveal">
          <h3>Association management</h3>
          <p class="dim">Trade and professional associations, from the annual meeting to the weekly email.</p>
        </li>
        <li class="reveal">
          <h3>Two precast industry directories</h3>
          <p class="dim"><a href="https://findprecast.com" rel="noopener">findprecast.com</a> for people looking for a producer, and <a href="https://makeprecast.com" rel="noopener">makeprecast.com</a> for people who want to work in the industry.</p>
        </li>
        <li class="reveal">
          <h3>Marketing programs for manufacturers</h3>
          <p class="dim">Websites, search, photography and social media for precast and building-product companies.</p>
        </li>
        <li class="reveal run__note">
          <p class="dim">Client work is confidential. We name a client only with its permission.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- THE REPORT -->
  <section class="section report">
    <div class="container split">
      <div class="report__cover" aria-hidden="true">
        <div>
          <p class="report__kicker">SkyKPI</p>
          <p class="report__title">The State of Precast Marketing</p>
          <p class="report__edition">First edition</p>
        </div>
      </div>
      <div>
        <p class="tag reveal">Annual report</p>
        <h2 class="reveal">Every year we grade producer websites and publish what we find.</h2>
        <p class="reveal">Eight checks, drawn from what architects told the AIA they need and from how search engines and AI assistants read a page. The report names no one. It shows where the industry stands and what to fix.</p>
        <a class="textlink reveal" href="/report/">About the report</a>
      </div>
    </div>
  </section>

  <!-- HOW WE CHARGE -->
  <section class="section charge">
    <div class="container split">
      <div>
        <p class="tag reveal">Pricing</p>
        <h2 class="reveal">How we charge</h2>
      </div>
      <div class="reveal">
        <ul class="charge__list">
          <li><strong>From $8,500 a month</strong><span>Marketing retainers for manufacturers and subcontractors.</span></li>
          <li><strong>From $1,500</strong><span>Websites for architecture firms and local businesses, with care from $50 a month.</span></li>
          <li><strong>Quoted</strong><span>Association management and custom systems, after one conversation.</span></li>
        </ul>
        <p class="dim">No hourly billing and no surprise invoices.</p>
        <a class="textlink" href="/pricing/">See pricing</a>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section how">
    <div class="container">
      <p class="tag reveal">How we work</p>
      <h2 class="reveal">How an engagement works</h2>
      <ol class="cols cols--3 how__steps">
        <li class="reveal">
          <h3>1. Scope</h3>
          <p class="dim">
            It starts with one conversation about what you need. We tell you
            plainly what we would do and what it costs.
          </p>
        </li>
        <li class="reveal">
          <h3>2. Build</h3>
          <p class="dim">
            One team writes, designs, builds and shoots the photography. You review finished work.
          </p>
        </li>
        <li class="reveal">
          <h3>3. Run</h3>
          <p class="dim">
            We keep it running for a flat monthly fee, and you get a one-page report each month.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="section on-navy cta">
    <div class="container cta__inner">
      <h2 class="reveal">Tell us what you are working on.</h2>
      <p class="dim reveal cta__copy">
        Send a note about what you sell, what your board needs handled, or the system you wish you had. We answer within one business day.
      </p>
      <div class="reveal">
        <a class="btn" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Sheet>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: calc(92svh - var(--header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding: 4rem 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero__label {
    margin-bottom: 1.25rem;
  }

  .hero__content h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5.6vw, 4.5rem);
  }

  .hero__identity {
    max-width: 38rem;
    margin-top: 1.5rem;
  }

  .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* FACTS */
  .facts h2 {
    max-width: 24ch;
  }

  .facts__list {
    list-style: none;
    margin: 2.5rem 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .facts__list li {
    border-top: 1px solid var(--hairline-on-black);
    padding-top: 1.25rem;
  }

  .facts__list strong {
    display: block;
    font-size: clamp(2.75rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
    color: var(--teal);
    margin-bottom: 0.75rem;
  }

  .facts__note {
    color: var(--white);
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 300;
    max-width: 40rem;
  }

  @media (max-width: 820px) {
    .facts__list {
      grid-template-columns: 1fr;
    }
  }

  /* SERVICES */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 2.5rem;
  }

  .service {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 0 0;
    border-top: 4px solid var(--navy);
    text-decoration: none;
    color: inherit;
  }

  .service:hover {
    border-top-color: var(--teal);
  }

  .service .tag {
    margin-bottom: 0.75rem;
  }

  .service h3 {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    margin-bottom: 0.6rem;
  }

  .service .textlink {
    margin-top: auto;
    align-self: flex-start;
  }

  .service .dim {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 820px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }

  /* WHAT WE RUN */
  .run__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .run__list li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }

  .run__list h3 {
    margin-bottom: 0.4rem;
  }

  .run__list p {
    margin: 0;
  }

  .run__note {
    font-size: 15px;
  }

  /* REPORT */
  .report__cover {
    aspect-ratio: 8.5 / 11;
    max-width: 16rem;
    background: var(--navy);
    box-shadow: 0 30px 50px -30px rgba(13, 41, 88, 0.6);
    display: flex;
  }

  .report__cover > div {
    margin: auto 1.5rem 1.5rem;
    border-top: 4px solid var(--teal);
    padding-top: 1rem;
    color: var(--white);
  }

  .report__kicker {
    margin: 0 0 1rem;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--graphite-on-black);
  }

  .report__title {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .report__edition {
    margin: 0;
    font-size: 12px;
    color: var(--white);
  }

  @media (max-width: 820px) {
    .report__cover {
      max-width: 12rem;
    }
  }

  /* CHARGE */
  .charge__list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .charge__list li {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .charge__list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .charge__list strong {
    font-weight: 500;
    color: var(--navy);
  }

  @media (max-width: 560px) {
    .charge__list li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  /* HOW */
  .how__steps h3 {
    margin: 0 0 0.5rem;
  }

  .how__steps p {
    margin: 0;
  }

  /* CTA */
  .cta__inner {
    max-width: 44rem;
  }

  .cta__copy {
    margin-bottom: 2rem;
  }
</style>
