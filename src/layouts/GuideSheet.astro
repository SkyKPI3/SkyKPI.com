---
/**
 * GuideSheet: the shared frame for Guides articles.
 * Wraps Sheet with the guide title block, the hero photograph, Article + FAQ
 * schema, the closing CTA, and related links. The article body flows in
 * through the default slot using the shared guide components.
 *
 * A guide dated in the future is buildable and previewable at its URL but
 * carries noindex until the rebuild on or after its publish date.
 */
import { Image } from 'astro:assets';
import Sheet from './Sheet.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import { faqSchema, type FaqItem } from '../lib/schema';

interface RefLink {
  href: string;
  label: string;
}

interface Props {
  slug: string;
  title: string; // page <title>, keyword-first
  metaDescription: string;
  h1: string;
  lede: string;
  published: string; // YYYY-MM-DD
  heroImage: ImageMetadata;
  heroAlt: string;
  faqs: FaqItem[];
  faqHeading: string;
  about: string[]; // Article schema topics
  ctaHeading: string;
  ctaCopy: string;
  ctaHref?: string;
  ctaLabel?: string;
  refs: RefLink[];
}

const {
  slug,
  title,
  metaDescription,
  h1,
  lede,
  published,
  heroImage,
  heroAlt,
  faqs,
  faqHeading,
  about,
  ctaHeading,
  ctaCopy,
  ctaHref = '/contact/',
  ctaLabel = 'Contact us',
  refs,
} = Astro.props;

const url = `https://skykpi.com/guides/${slug}/`;
const isEmbargoed = published > new Date().toISOString().slice(0, 10);

const publishedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${published}T00:00:00Z`));

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description: metaDescription,
  datePublished: published,
  dateModified: published,
  url,
  image: 'https://skykpi.com/og-default.png',
  author: { '@type': 'Organization', name: 'SkyKPI', url: 'https://skykpi.com' },
  publisher: { '@id': 'https://skykpi.com/#organization' },
  about,
};
---

<Sheet
  title={title}
  description={metaDescription}
  path={`/guides/${slug}/`}
  sheetName={`Guides / ${h1.split(',')[0].split(':')[0]}`}
  parent={{ href: '/guides/', label: 'Guides' }}
  jsonLd={[article]}
  noindex={isEmbargoed}
>
  <section class="section gtitle">
    <div class="container gtitle__inner">
      <p class="tag">Guides</p>
      <h1>{h1}</h1>
      <p class="meta gtitle__meta">
        Published <time datetime={published}>{publishedLabel}</time>
      </p>
      <p class="lede gtitle__lede">{lede}</p>
    </div>
  </section>

  <div class="ghero">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[480, 768, 1280, 1920]}
      width={1920}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={78}
    />
  </div>

  <slot />

  <Faq items={faqs} heading={faqHeading} />

  <section class="section gcta">
    <div class="container gcta__inner">
      <h2 class="reveal">{ctaHeading}</h2>
      <p class="dim reveal gcta__copy">{ctaCopy}</p>
      <div class="reveal">
        <a class="btn" href={ctaHref}>{ctaLabel}</a>
      </div>
    </div>
  </section>

  <Related links={refs} />
</Sheet>

<style>
  .gtitle {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .gtitle__inner {
    max-width: 52rem;
  }

  .gtitle__meta {
    margin: 0 0 1.75rem;
  }

  .gtitle__lede {
    max-width: 44rem;
  }

  .ghero {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 70svh;
    overflow: hidden;
  }

  .ghero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gcta__inner {
    max-width: 44rem;
  }

  .gcta__copy {
    margin-bottom: 2rem;
  }
</style>
