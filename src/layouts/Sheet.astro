---
/**
 * Sheet: the shared page layout.
 * White header with the wordmark and nav, the page body, and a navy footer.
 * Carries the head tags, canonical, Open Graph, and the Organization,
 * WebSite, and BreadcrumbList JSON-LD every page needs.
 */
import '@fontsource/libre-franklin/latin-300.css';
import '@fontsource/libre-franklin/latin-400.css';
import '@fontsource/libre-franklin/latin-500.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/skykpi-wordmark.png';
import wordmarkReverse from '../assets/brand/skykpi-wordmark-reverse.png';

// Field Notes stays out of the nav until the first entry exists, so the
// section never ships as an empty page.
const hasFieldNotes = (await getCollection('fieldnotes')).length > 0;

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/manufacturers/"
  sheetName: string; // breadcrumb label, e.g. "Home"
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
  // Set on pages that sit under another page, e.g. Architects under Marketing.
  parent?: { href: string; label: string };
}

const {
  title,
  description,
  path,
  sheetName,
  ogImage = '/og-default.png',
  jsonLd = [],
  noindex = false,
  parent,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

// One stable @id sitewide so search and answer engines merge every page's
// markup into a single entity rather than treating each page as its own firm.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://skykpi.com/#organization',
  name: 'SkyKPI',
  legalName: 'SkyKPI LLC',
  alternateName: 'SkyKPI',
  url: 'https://skykpi.com',
  logo: 'https://skykpi.com/brand/skykpi-wordmark.png',
  image: 'https://skykpi.com/og-default.png',
  email: 'hello@skykpi.com',
  description:
    'SkyKPI builds websites, marketing and custom software for precast concrete and building-product manufacturers, subcontractors and architects, and manages trade and professional associations. It also builds websites for small businesses in Frankfort, New Lenox and Mokena, Illinois. Based in Frankfort, Illinois, working nationwide.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frankfort',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  knowsAbout: [
    'Precast concrete',
    'Precast concrete marketing',
    'Architecture, engineering, and construction (AEC)',
    'AEC marketing',
    'Trade association management',
    'Association management for trade associations',
    'Marketing for architects',
    'Marketing for subcontractors',
    'Building product manufacturer websites',
    'Association management software',
    'Member portals',
    'Small business websites',
  ],
  sameAs: ['https://www.linkedin.com/company/skykpi/'],
};

// WebSite entity on the home page only, linked to the organization by @id,
// so engines tie the site and the firm together as one graph.
const website =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': 'https://skykpi.com/#website',
        url: 'https://skykpi.com/',
        name: 'SkyKPI',
        publisher: { '@id': 'https://skykpi.com/#organization' },
      }
    : null;

// Breadcrumbs on every page except home, so results show the page's place
// on the site rather than a bare URL.
const breadcrumb =
  path === '/'
    ? null
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://skykpi.com/' },
          ...(parent
            ? [
                {
                  '@type': 'ListItem',
                  position: 2,
                  name: parent.label,
                  item: new URL(parent.href, 'https://skykpi.com/').href,
                },
              ]
            : []),
          {
            '@type': 'ListItem',
            position: parent ? 3 : 2,
            name: sheetName,
            item: canonical,
          },
        ],
      };

const nav = [
  {
    href: '/manufacturers/',
    label: 'Services',
    children: [
      { href: '/manufacturers/', label: 'Marketing for manufacturers and subcontractors' },
      { href: '/associations/', label: 'Association management' },
      { href: '/custom-systems/', label: 'Custom systems and portals' },
      { href: '/architects/', label: 'Websites for architects' },
      { href: '/local/', label: 'Websites for local businesses' },
    ],
  },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/guides/', label: 'Guides' },
  { href: '/report/', label: 'Report' },
  ...(hasFieldNotes ? [{ href: '/field-notes/', label: 'Field Notes' }] : []),
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const footerLinks = [
  { href: '/manufacturers/', label: 'Manufacturers and subcontractors' },
  { href: '/associations/', label: 'Association management' },
  { href: '/custom-systems/', label: 'Custom systems' },
  { href: '/architects/', label: 'Architects' },
  { href: '/local/', label: 'Local businesses' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/guides/', label: 'Guides' },
  ...(hasFieldNotes ? [{ href: '/field-notes/', label: 'Field Notes' }] : []),
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0D2958" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SkyKPI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SkyKPI wordmark on a white card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {website && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!--
      Analytics: none, on purpose. The privacy policy promises no tracking
      cookies. If analytics are ever wanted, enable Netlify Analytics in the
      Netlify dashboard (server side, cookieless). No code change is needed
      here and the policy stays true.
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/" aria-label="SkyKPI home">
          <Image
            class="site-header__wordmark"
            src={wordmark}
            alt="SkyKPI"
            widths={[150, 300, 450]}
            sizes="150px"
            width={150}
            loading="eager"
          />
        </a>

        <nav class="site-nav" aria-label="Main">
          <button
            class="site-nav__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-list"
          >
            Menu
          </button>
          <ul id="site-nav-list" class="site-nav__list">
            {
              nav.map((item) => (
                <li class:list={{ 'has-sub': !!item.children }}>
                  <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                  {item.children && (
                    <ul class="site-nav__sub">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={path === child.href ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <Image
          class="site-footer__wordmark"
          src={wordmarkReverse}
          alt="SkyKPI"
          widths={[140, 280, 420]}
          sizes="140px"
          width={140}
          loading="lazy"
        />
        <p class="site-footer__line">
          Websites, marketing and custom software for manufacturers, subcontractors and architects, and management for associations. Based in Frankfort, Illinois, working nationwide.
        </p>

        <ul class="site-footer__links">
          {footerLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>

        <div class="site-footer__legal">
          <p>
            SkyKPI LLC.{' '}
            <a href="/privacy/">Privacy</a>
          </p>
          <p>
            <a href="mailto:hello@skykpi.com">hello@skykpi.com</a>
            <a href="https://www.linkedin.com/company/skykpi/" rel="noopener">LinkedIn</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline src="/site.js" defer></script>

    <style>
      /* Header: white, in normal flow, not sticky */
      .site-header {
        position: relative;
        z-index: 50;
        background: var(--white);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: var(--header-h);
        width: min(72rem, 100% - 2 * var(--gutter));
        margin-inline: auto;
      }

      .site-header__brand {
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .site-header__wordmark {
        width: 150px;
        height: auto;
      }

      .site-nav {
        margin-left: auto;
      }

      .site-nav__toggle {
        display: none;
        background: none;
        border: 0;
        color: var(--black);
        font-family: var(--font);
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        padding: 0.5rem 0;
      }

      .site-nav__list {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-nav__list a {
        font-family: var(--font);
        font-size: 15px;
        font-weight: 400;
        text-decoration: none;
        color: var(--navy);
        padding-bottom: 0.2rem;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
      }

      .site-nav__list a:hover,
      .site-nav__list a[aria-current='page'] {
        border-bottom-color: var(--teal);
      }

      /* Services sub-navigation */
      .has-sub {
        position: relative;
      }

      .site-nav__sub {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      @media (min-width: 821px) {
        .site-nav__sub {
          position: absolute;
          top: 100%;
          left: -1.25rem;
          min-width: 19rem;
          padding: 0.6rem 0;
          background: var(--white);
          border: 1px solid var(--hairline);
          opacity: 0;
          visibility: hidden;
          transform: translateY(6px);
          transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
        }

        .has-sub:hover .site-nav__sub,
        .has-sub:focus-within .site-nav__sub {
          opacity: 1;
          visibility: visible;
          transform: none;
        }

        .site-nav__sub a {
          display: block;
          padding: 0.55rem 1.25rem;
          border-bottom: 0;
        }

        .site-nav__sub a:hover,
        .site-nav__sub a[aria-current='page'] {
          color: var(--teal-text);
        }

        /* keep the dropdown reachable while moving the pointer */
        .has-sub::after {
          content: '';
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          height: 0.8rem;
        }
      }

      @media (max-width: 820px) {
        .site-header__wordmark {
          width: 120px;
        }

        .site-nav__toggle {
          display: inline-block;
        }

        .site-nav__list {
          display: none;
          position: absolute;
          top: var(--header-h);
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 0;
          background: var(--white);
          border-top: 1px solid var(--hairline);
          border-bottom: 1px solid var(--hairline);
          padding: 0.5rem 0;
        }

        .site-nav__list.is-open {
          display: flex;
        }

        .site-nav__list a {
          display: block;
          padding: 0.9rem var(--gutter);
          border-bottom: 0;
        }

        .site-nav__sub a {
          padding-left: calc(var(--gutter) + 1.25rem);
          color: var(--graphite);
        }
      }

      /* Footer: black ground */
      .site-footer {
        background: var(--navy);
        color: var(--white);
        padding: 4rem 0 2.5rem;
      }

      .site-footer__wordmark {
        width: 140px;
        height: auto;
      }

      .site-footer__line {
        margin: 1.5rem 0 0;
        max-width: 40rem;
        font-size: 15px;
        line-height: 1.5;
        color: var(--graphite-on-black);
      }

      .site-footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.75rem;
        list-style: none;
        margin: 2.5rem 0 0;
        padding: 2rem 0 0;
        border-top: 1px solid var(--hairline-on-black);
      }

      .site-footer__links a {
        font-size: 15px;
        font-weight: 400;
        color: var(--white);
        text-decoration: none;
      }

      .site-footer__links a:hover {
        color: var(--graphite-on-black);
      }

      .site-footer__legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem 2rem;
        margin-top: 3rem;
        font-size: 14px;
        color: var(--graphite-on-black);
      }

      .site-footer__legal p {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
      }

      .site-footer__legal a {
        color: var(--graphite-on-black);
        text-decoration: none;
      }

      .site-footer__legal a:hover {
        color: var(--white);
      }
    </style>
  </body>
</html>
